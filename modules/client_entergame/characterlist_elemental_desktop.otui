        text-auto-resize: false
        text-wrap: false
        text-align: center

      Panel
        id: selectedCharacterFacts
        anchors.left: selectedCharacterPreview.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        height: 112
        margin-left: 24

        Panel
          id: selectedCharacterLevelCard
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          margin-right: 6
          height: 52
          background-color: #10151d
          border-width: 1
          border-color: #39424e

          Label
            id: selectedCharacterLevelHeading
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 7
            text: NIVEL
            color: #aeb4c0
            font: Verdana Bold-10px
            text-auto-resize: true

          Label
            id: selectedCharacterLevel
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 7
            color: #ffbd6b
            font: Verdana Bold-11px
            text-auto-resize: true
            visible: false

        Panel
          id: selectedCharacterVocationCard
          anchors.top: parent.top
          anchors.left: parent.horizontalCenter
          anchors.right: parent.right
          margin-left: 6
          height: 52
          background-color: #10151d
          border-width: 1
          border-color: #39424e

          Label
            id: selectedCharacterVocationHeading
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 7
            text: VOCACAO
            color: #aeb4c0
            font: Verdana Bold-10px
            text-auto-resize: true

          Label
            id: selectedCharacterVocation
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 7
            color: #f7f1e4
            font: Verdana Bold-11px
            text-auto-resize: true
            visible: false

        Panel
          id: selectedCharacterRaceCard
          anchors.top: selectedCharacterLevelCard.bottom
          anchors.left: parent.left
          anchors.right: parent.horizontalCenter
          margin-top: 8
          margin-right: 6
          height: 52
          background-color: #10151d
          border-width: 1
          border-color: #39424e

          Label
            id: selectedCharacterRaceHeading
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 7
            text: ORIGEM
            color: #aeb4c0
            font: Verdana Bold-10px
            text-auto-resize: true

          Label
            id: selectedCharacterRace
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 7
            color: #aeb4c0
            font: verdana-11px-antialised
            text-auto-resize: true
            visible: false

        Panel
          id: selectedCharacterWorldCard
          anchors.top: selectedCharacterVocationCard.bottom
          anchors.left: parent.horizontalCenter
          anchors.right: parent.right
          margin-top: 8
          margin-left: 6
          height: 52
          background-color: #10151d
          border-width: 1
          border-color: #39424e

          Label
            id: selectedCharacterWorldHeading
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            margin-top: 7
            text: MUNDO
            color: #aeb4c0
            font: Verdana Bold-10px
            text-auto-resize: true

          Label
            id: selectedCharacterWorld
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            margin-bottom: 7
            color: #aeb4c0
            font: verdana-11px-antialised
            text-auto-resize: true
            visible: false

      ElementalPrimaryButton
        id: buttonOk
        anchors.horizontalCenter: parent.horizontalCenter
        margin-left: 105
        anchors.bottom: parent.bottom
        margin-bottom: -17
        width: 290
        height: 48
        text: Escolher Personagem
        visible: false
        @onClick: |
          if CharacterList.cancelLogin() then
            EnterGame.playUiClickSound()
            return
          end
          EnterGame.playUiConfirmSound()
          CharacterList.doLogin()

      Label
        id: worldConnectionStatus
        anchors.horizontalCenter: parent.horizontalCenter
        margin-left: 105
        anchors.bottom: buttonOk.top
        margin-bottom: 4
        width: 290
        height: 24
        color: #ffbd6b
        font: Verdana Bold-11px
        text-wrap: true
        text-align: center
        text-vertical-auto-resize: false
        visible: false

    Label
      id: selectedCharacterEmpty
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 36
      margin-right: 36
      height: 50
      text: Crie seu primeiro personagem para entrar no mundo Elemental.
      text-wrap: true
      text-align: center
      color: #aeb4c0
      font: verdana-11px-antialised

    ElementalSecondaryButton
      id: buttonCancel
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 110
      height: 38
      text: Sair
      visible: false
      @onClick: |
        EnterGame.playUiClickSound()
        CharacterList.hide(true)
