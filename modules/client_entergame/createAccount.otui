ElementalModal
  id: mainWindow
  size: 390 285
  !text: tr('Create Account')
  @onEscape: toggleCreateAccount(true)
  @onEnter: onClickStartPlaying()

  Panel
    id: accountForm
    anchors.fill: parent
    margin: 12

    Label
      id: accountIntro
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 30
      text-wrap: true
      text: 'Create an account first. You will choose your character from the character list.'

    Label
      anchors.top: accountIntro.bottom
      anchors.left: parent.left
      margin-top: 8
      !text: tr('Email')

    TextEdit
      id: accountEmail
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 22

    Label
      anchors.top: accountEmail.bottom
      anchors.left: parent.left
      margin-top: 8
      !text: tr('Password')

    PasswordTextEdit
      id: accountPassword
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 22

    Label
      anchors.top: accountPassword.bottom
      anchors.left: parent.left
      margin-top: 8
      !text: tr('Repeat Password')

    PasswordTextEdit
      id: repeatPassword
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 22

    Label
      id: accountStatus
      anchors.top: repeatPassword.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 34
      text-wrap: true
      color: #c0c0c0

    Button
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 125
      height: 24
      !text: tr('Already Registered')
      @onClick: toggleCreateAccount(true)

    UIButton
      id: buttonStartPlaying
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 120
      height: 28
      text: 'Create Account'
      font: cipsoftFont
      image-source: /images/ui/createaccount/button_startplaying
      @onClick: onClickStartPlaying()
      $pressed:
        image-source: /images/ui/createaccount/button_startplaying_down
        text-offset: 1 1
