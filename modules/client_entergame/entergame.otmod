Module
  name: client_entergame
  description: Manages enter game and character list windows
  author: edubart
  website: https://github.com/edubart/otclient

  dependencies:
    - client_assets
    - client_launcher_update
    - client_launcher_android_update
    - game_features
    - game_things

  @onLoad: |
    dofile 'entergame'
    dofile 'characterlist'
    dofile 'createAccount'
    dofile 'mobile_launcher'
    EnterGame.init()
    CharacterList.init()

  @onUnload: |
    MobileLauncher.terminate()
    EnterGame.terminate()
    CharacterList.terminate()
