    Label
      id: emailSectionTitle
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 5
      height: 18
      !text: tr('Change email')
      color: #f0c36d

    Label
      anchors.left: parent.left
      anchors.top: emailSectionTitle.bottom
      margin-top: 1
      height: 16
      !text: tr('Current password')

    HiddenTextQtEdit
      id: emailCurrentPasswordEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 1
      height: 22
      text-hidden: true

    Label
      anchors.left: parent.left
      anchors.top: emailCurrentPasswordEdit.bottom
      margin-top: 2
      height: 16
      !text: tr('New email address')

    TextEdit
      id: emailNewAddressEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 1
      height: 22

    Label
      anchors.left: parent.left
      anchors.top: emailNewAddressEdit.bottom
      margin-top: 2
      height: 16
      !text: tr('Confirmation code')

    TextEdit
      id: emailCodeEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 1
      height: 22

    Button
      id: requestEmailCodeButton
      anchors.left: parent.left
      anchors.top: emailCodeEdit.bottom
      margin-top: 4
      width: 190
      height: 24
      !text: tr('Send confirmation code')

    Button
      id: confirmEmailButton
      anchors.left: requestEmailCodeButton.right
      anchors.top: requestEmailCodeButton.top
      margin-left: 8
      width: 150
      height: 24
      !text: tr('Confirm email')

    Label
      id: accountStatus
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: closeAccountButton.top
      margin-bottom: 5
      height: 32
      text-wrap: true
      color: #c0c0c0

    Button
      id: closeAccountButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 82
      height: 24
      !text: tr('Close')

CharacterWidget < UIWidget
  height: 14
  background-color: alpha
  &updateOnStates: |
    function(self)
      local focused = self:isFocused()
      local children = self:getChildren()
      for i=1,#children do
        children[i]:setOn(focused)
      end
      if self.rowColor then
        if focused then
          self:setBackgroundColor("#696767")
          self:setBorderWidth(1)
          self:setBorderColor("#696767")
        else
          self:setBackgroundColor(self.rowColor)
          self:setBorderWidth(0)
          self:setBorderColor("alpha")
        end
      end
      local pin = self:getChildById('pin')
      if pin then
        pin:setVisible(focused and g_game.getFeature(GameEnterGameShowAppearance))
      end
    end
  @onFocusChange: self:updateOnStates()
  @onSetup: |
    self:updateOnStates()
    if g_game.getFeature(GameEnterGameShowAppearance) then
      self:setHeight(64)
    end

  UICreature
    id: outfitCreatureBox
    size: 64 64
    anchors.top: parent.top
    anchors.left: parent.left
    padding-left: 10
    padding-bottom: 5
    fixed-creature-size: true
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: name
    color: #bbbbbb
    anchors.top: parent.top
    anchors.left: parent.left
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    text-offset: 2 0
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginLeft(65)
      end

    $on:
      color: #ffffff

  Label
    id: mainCharacter
    size: 9 8
    anchors.top: parent.top
    anchors.left: prev.right
    margin-left: 6
    margin-top: 2
    image-source: /images/game/entergame/maincharacter
    image-clip: 0 0 9 8
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  CheckBoxButton
    id: pin
    size: 12 12
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 236
    margin-top: 2
    visible: false
    tooltip: Pin this character to have it always shown at the top of the list.
    icon-source: /game_questlog/images/icon-pin
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end
    @onCheckChange: onPinCharacter(self, self:isChecked())
    $checked:
      tooltip: Remove pin from this character.
      image-color: red

  Label
    id: statusDailyReward
    size: 11 19
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 252
    margin-top: 2
    image-source: /images/game/entergame/dailyreward_collected
    image-clip: 0 0 11 19
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: statusHidden
    size: 11 19
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 267
    margin-top: 2
    image-source: /images/game/entergame/hidden
    image-clip: 0 0 11 19
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: level
    color: #bbbbbb
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 350
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    text-offset: 2 0
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  Label
    id: vocation
    color: #bbbbbb
    anchors.top: parent.top
    anchors.left: parent.left
    margin-left: 410
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    text-offset: 2 0
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    $on:
      color: #ffffff

  Label
    id: raceName
    color: #aaaaaa
    anchors.top: vocation.bottom
    anchors.left: parent.left
    margin-left: 410
    margin-top: 2
    font: verdana-11px-monochrome
    text-auto-resize: true
    background-color: alpha
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: worldName
    color: #bbbbbb
    anchors.top: parent.top
    font: verdana-11px-monochrome
    text-auto-resize: true
    text-wrap: true
    background-color: alpha
    &baseText: '(%s)'
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:addAnchor(AnchorLeft, 'parent', AnchorLeft)
        self:setMarginLeft(502)
        self:setWidth(225)
        self:setHeight(26)
        self.baseText = '%s'
      else
        self:addAnchor(AnchorRight, 'parent', AnchorRight)
        self:setMarginRight(5)
      end

    $on:
      color: #ffffff

MainWindow
  id: charactersWindow
  !text: tr('Character List')
  visible: false
  @onEnter: CharacterList.doLogin()
  @onEscape: CharacterList.hide(true)
  @onSetup: |
    g_keyboard.bindKeyPress('Up', function() self:getChildById('characters'):focusPreviousChild(KeyboardFocusReason) end, self)
    g_keyboard.bindKeyPress('Down', function() self:getChildById('characters'):focusNextChild(KeyboardFocusReason) end, self)
    if g_game.getFeature(GamePreviewState) then
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setSize({width = 745, height = 430})
        self:setText(tr('Select Character'))
        self:setColor("#c0c0c0")
      else
        self:setSize({width = 350, height = 400})
        self:setText(tr('Character List'))
      end
    else
      self:setSize({width = 250, height = 248})
    end

  TextList
    id: characters
    background-color: #404040
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474
    padding: 1 1 1 1
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: characterListScrollBar.left
    anchors.bottom: accountStatusCaption.top
    margin-bottom: 5
    padding: 1
    focusable: false
    vertical-scrollbar: characterListScrollBar
    auto-focus: first
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setBackgroundColor("#404040")
        self:setPaddingTop(20)
      else
        self:setBackgroundColor("#565656")
      end

  Label
    id: emptyCharacterPrompt
    anchors.fill: characters
    margin-top: 38
    padding-left: 12
    padding-right: 12
    text-wrap: true
    text-align: center
    text-vertical-auto-resize: true
    color: #c0c0c0
    visible: false

  UIWidget
    id: characterTable
    anchors.left: parent.left
    anchors.right: characterListScrollBar.left
    anchors.top: characters.top
    height: 19
    border-width: 1
    border-color-top: #1B1B1A
    border-color-left: #1B1B1A
    border-color-right: #6b6b6b
    border-color-bottom: #6b6b6b
    background-color: #363636
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

    UIButton
      id: characterSort
      size: 250 14
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      !text: tr('Character')
      text-offset: -30 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      image-source: /images/game/entergame/sort-button
      image-clip: 0 0 7 4
      image-size: 7 4
      image-offset: 242 5
      @onClick: onSortButtonClick(self, 1)
      $pressed:
        color: #9d9d9d
        image-clip: 0 4 7 4
      $checked:
        image-clip: 0 4 7 4
      $!on:
        image-source:
      $on:
        image-source: /images/game/entergame/sort-button

    UIButton
      id: statusSort
      size: 100 14
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 250
      margin-top: 2
      !text: tr('Status')
      text-offset: -20 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      image-source: /images/game/entergame/sort-button
      image-clip: 0 0 7 4
      image-size: 7 4
      image-offset: 92 5
      @onClick: onSortButtonClick(self, 2)
      $pressed:
        color: #9d9d9d
        image-clip: 0 4 7 4
      $checked:
        image-clip: 0 4 7 4
      $!on:
        image-source:
      $on:
        image-source: /images/game/entergame/sort-button

    UIButton
      id: levelSort
      size: 60 14
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 350
      margin-top: 2
      !text: tr('Level')
      text-offset: -8 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      image-source: /images/game/entergame/sort-button
      image-clip: 0 0 7 4
      image-size: 7 4
      image-offset: 52 5
      @onClick: onSortButtonClick(self, 3)
      $pressed:
        color: #9d9d9d
        image-clip: 0 4 7 4
      $checked:
        image-clip: 0 4 7 4
      $!on:
        image-source:
      $on:
        image-source: /images/game/entergame/sort-button

    UIButton
      id: vocationSort
      size: 90 14
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 410
      margin-top: 2
      !text: tr('Vocation')
      text-offset: -10 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      image-source: /images/game/entergame/sort-button
      image-clip: 0 0 7 4
      image-size: 7 4
      image-offset: 82 5
      @onClick: onSortButtonClick(self, 4)
      $pressed:
        color: #9d9d9d
        image-clip: 0 4 7 4
      $checked:
        image-clip: 0 4 7 4
      $!on:
        image-source:
      $on:
        image-source: /images/game/entergame/sort-button

    UIButton
      id: worldSort
      size: 230 14
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 500
      margin-top: 2
      !text: tr('World')
      text-offset: -85 0
      font: verdana-11px-monochrome
      color: #c0c0c0
      image-source: /images/game/entergame/sort-button
      image-clip: 0 0 7 4
      image-size: 7 4
      image-offset: 212 5
      @onClick: onSortButtonClick(self, 5)
      $pressed:
        color: #9d9d9d
        image-clip: 0 4 7 4
      $checked:
        image-clip: 0 4 7 4
      $!on:
        image-source:
      $on:
        image-source: /images/game/entergame/sort-button

  VerticalScrollBar
    id: characterListScrollBar
    anchors.top: parent.top
    anchors.bottom: accountStatusCaption.top
    anchors.right: parent.right
    margin-bottom: 5
    step: 14
    pixels-scroll: true

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 249
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 349
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 409
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  VerticalSeparator
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: prev.bottom
    margin-left: 500
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: accountStatusCaption
    !text: tr('Account Status') .. ':'
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(5)
      else
        self:setMarginBottom(1)
      end

  Label
    id: accountStatusIcon
    size: 22 20
    anchors.left: parent.left
    anchors.bottom: next.bottom
    image-source: /images/game/entergame/premium
    image-clip: 0 0 22 20
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:hide()
      end

  Label
    id: accountStatusLabel
    !text: tr('Free Account')
    anchors.left: parent.left
    text-auto-resize: true
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(15)
        self:setPaddingBottom(2)
        self:setTextOffset({x = 25, y = 0})
        self:addAnchor(AnchorBottom, 'separator', AnchorBottom)
      else
        self:setMarginBottom(5)
        self:addAnchor(AnchorRight, 'parent', AnchorRight)
        self:addAnchor(AnchorBottom, 'separator', AnchorTop)
      end

    $on:
      color: #FF0000

  Button
    id: premiumButton
    !text: tr('Get Premium')
    anchors.right: parent.right
    text-auto-resize: true
    image-color: green
    @onClick: onPremiumButtonClick(self)
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(15)
        self:setPaddingBottom(2)
        self:addAnchor(AnchorBottom, 'separator', AnchorBottom)
      end


  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: premiumBenefitsPanel.top
    height: 2
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setMarginBottom(6)
      else
        self:setMarginBottom(10)
      end

  Panel
    id: premiumBenefitsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonHidden.top

    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:setHeight(0)
        self:setMarginBottom(0)
        self:hide()
      end


    Label
      id: premiumBenefitsTitle
      !text: tr('Premium Benefits include:')
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 2
      padding-left: 6
      padding-right: 6
      color: #cfcfcf
      font: verdana-11px-monochrome
      text-auto-resize: true

    UIWidget
      id: premiumBenefitSpells
      size: 210 52
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 22
      margin-left: 12

      UIWidget
        id: premiumBenefitSpellsIcon
        size: 32 32
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        image-source: /images/game/entergame/premium-icons-32x32
        image-clip: 32 0 32 32

      Label
        id: premiumBenefitSpellsText
        !text: tr('No level cap while training your skills offline')
        anchors.top: premiumBenefitSpellsIcon.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        font: verdana-11px-monochrome
        color: #d7d7d7
        width: 160
        text-wrap: true
        text-align: center
        text-vertical-auto-resize: true

    UIWidget
      id: premiumBenefitMounts
      size: 210 52
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.top: parent.top
      margin-top: 22

      UIWidget
        id: premiumBenefitMountsIcon
        size: 32 32
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        image-source: /images/game/entergame/premium-icons-32x32
        image-clip: 96 0 32 32

      Label
        id: premiumBenefitMountsText
        !text: tr('Tame mounts to travel faster')
        anchors.top: premiumBenefitMountsIcon.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        text-auto-resize: true
        font: verdana-11px-monochrome
        color: #d7d7d7

    UIWidget
      id: premiumBenefitVip
      size: 210 52
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 22
      margin-right: 12

      UIWidget
        id: premiumBenefitVipIcon
        size: 32 32
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        image-source: /images/game/entergame/premium-icons-32x32
        image-clip: 512 0 32 32

      Label
        id: premiumBenefitVipText
        !text: tr('Imbue items with stronger effect')
        anchors.top: premiumBenefitVipIcon.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 2
        width: 190
        text-wrap: true
        text-align: center
        text-vertical-auto-resize: true
        font: verdana-11px-monochrome
        color: #d7d7d7

    Label
      id: premiumBenefitsFooter
      !text: tr('... and many more!')
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 8
      text-auto-resize: true
      font: verdana-11px-monochrome
      color: #d7d7d7

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-right: 8
      height: 2

  Panel
    id: buttonHidden
    anchors.left: parent.left
    anchors.bottom: autoReconnect.top
    margin-bottom: 6
    size: 165 22
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:setHeight(0)
        self:setMarginBottom(0)
        self:hide()
      else
        self:setHeight(22)
        self:setMarginBottom(6)
      end
    CheckBox
      id: checkBoxHidden
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      checked: true
      !text: tr('Show Hidden Characters')
      text-auto-resize: true
      color: #c0c0c0
      @onCheckChange: onShowHiddenCharacters(self, self:isChecked())


  Panel
    id: buttonOutfit
    anchors.left: buttonHidden.right
    anchors.verticalCenter: buttonHidden.verticalCenter
    margin-left: 10
    size: 100 22
    border-width-top: 1
    border-color-top: black
    border-width-left: 1
    border-color-left: black
    border-width-bottom: 1
    border-color-bottom: #747474
    border-width-right: 1
    border-color-right: #747474
    padding: 1 1 1 1
    @onSetup: |
      if not(g_game.getFeature(GameEnterGameShowAppearance)) then
        self:setHeight(0)
        self:hide()
      else
        self:setHeight(22)
      end
    CheckBox
      id: checkBoxOutfit
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6      
      !text: tr('Show Outfit')
      text-auto-resize: true
      color: #c0c0c0
      @onCheckChange: onShowOutfits(self, self:isChecked())

  Button
    id: autoReconnect
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    @onSetup: |
      if g_game.getFeature(GameEnterGameShowAppearance) then
        self:setWidth(140)
      else
        self:setWidth(75)
        self:setFont('small-9px')
      end
    $!on:
      image-color: red
    $on:
      image-color: green

  Button
    id: buttonAccount
    anchors.left: autoReconnect.right
    anchors.verticalCenter: autoReconnect.verticalCenter
    margin-left: 8
    width: 92
    !text: tr('Account')
    visible: false
    @onClick: CharacterList.openAccountManagement()

  Button
    id: buttonOk
    !text: tr('Ok')
    width: 64
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    @onClick: CharacterList.doLogin()

  Button
    id: buttonCreateCharacter
    !text: tr('Create Character')
    width: 112
    anchors.right: next.left
    anchors.bottom: parent.bottom
    margin-right: 10
    visible: false
    @onClick: CharacterList.openCharacterAssembly()

  Button
    id: buttonCancel
    !text: tr('Cancel')
    width: 64
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: CharacterList.hide(true)
