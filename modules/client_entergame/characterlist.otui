ElementalCharacterAssemblyWindow < MainWindow
  id: elementalCharacterAssemblyWindow
  size: 510 515
  !text: tr('Create Character')
  @onEscape: CharacterList.closeCharacterAssembly()

  Panel
    id: assemblyPanel
    anchors.fill: parent
    margin: 12

    Label
      id: assemblyIntro
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 30
      text-wrap: true
      text: 'Choose every field before entering the world. No race or vocation is preselected.'

    Label
      id: characterNameLabel
      anchors.top: assemblyIntro.bottom
      anchors.left: parent.left
      margin-top: 5
      !text: tr('Character Name')

    TextEdit
      id: characterNameEdit
      anchors.top: prev.bottom
      anchors.left: parent.left
      width: 245
      margin-top: 3
      height: 22

    Label
      id: sexLabel
      anchors.top: characterNameEdit.bottom
      anchors.left: parent.left
      margin-top: 7
      !text: tr('Sex')

    QtComboBox
      id: sexCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 245

    Button
      id: retryOptionsButton
      anchors.left: sexCombo.right
      anchors.verticalCenter: sexCombo.verticalCenter
      margin-left: 6
      width: 78
      height: 22
      !text: tr('Retry')
      visible: false

    Label
      id: raceLabel
      anchors.top: sexCombo.bottom
      anchors.left: parent.left
      margin-top: 7
      !text: tr('Race')

    QtComboBox
      id: raceCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 245

    Label
      id: vocationLabel
      anchors.top: raceCombo.bottom
      anchors.left: parent.left
      margin-top: 7
      !text: tr('Vocation')

    QtComboBox
      id: vocationCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 245

    Label
      id: appearanceLabel
      anchors.top: vocationCombo.bottom
      anchors.left: parent.left
      margin-top: 7
      !text: tr('Appearance:')

    QtComboBox
      id: appearanceCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 245

    Label
      id: colorsLabel
      anchors.top: appearanceCombo.bottom
      anchors.left: parent.left
      margin-top: 7
      !text: tr('Colors')

    Label
      id: headColorLabel
      anchors.top: colorsLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      !text: tr('Head')

    QtComboBox
      id: headColorCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 2
      width: 112

    Label
      id: bodyColorLabel
      anchors.top: colorsLabel.bottom
      anchors.left: headColorCombo.right
      margin-left: 12
      margin-top: 4
      !text: tr('Body')

    QtComboBox
      id: bodyColorCombo
      anchors.top: bodyColorLabel.bottom
      anchors.left: bodyColorLabel.left
      margin-top: 2
      width: 112

    Label
      id: legsColorLabel
      anchors.top: headColorCombo.bottom
      anchors.left: parent.left
      margin-top: 5
      !text: tr('Legs')

    QtComboBox
      id: legsColorCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 2
      width: 112

    Label
      id: feetColorLabel
      anchors.top: legsColorLabel.top
      anchors.left: bodyColorLabel.left
      !text: tr('Feet')

    QtComboBox
      id: feetColorCombo
      anchors.top: feetColorLabel.bottom
      anchors.left: feetColorLabel.left
      margin-top: 2
      width: 112

    Label
      id: addonsLabel
      anchors.top: legsColorCombo.bottom
      anchors.left: parent.left
      margin-top: 6
      !text: tr('Addons')

    QtComboBox
      id: addonsCombo
      anchors.top: prev.bottom
      anchors.left: parent.left
      margin-top: 2
      width: 245

    Label
      id: previewTitle
      anchors.top: characterNameLabel.top
      anchors.left: parent.left
      margin-left: 315
      !text: tr('Preview')

    UICreature
      id: appearancePreview
      size: 128 128
      anchors.top: previewTitle.bottom
      anchors.left: previewTitle.left
      margin-top: 8
      fixed-creature-size: true
      visible: false

    Label
      id: previewHint
      anchors.top: appearancePreview.bottom
      anchors.left: previewTitle.left
      width: 160
      height: 48
      margin-top: 5
      text-wrap: true
      text-align: center
      text: 'The preview appears after every appearance field is selected.'

    Label
      id: assemblyStatus
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: cancelAssemblyButton.top
      margin-bottom: 7
      height: 30
      text-wrap: true
      color: #c0c0c0

    Button
      id: cancelAssemblyButton
      anchors.right: createCharacterButton.left
      anchors.bottom: parent.bottom
      margin-right: 8
      width: 82
      height: 24
      !text: tr('Cancel')

    UIButton
      id: createCharacterButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 120
      height: 28
      text: 'Create Character'
      font: cipsoftFont
      image-source: /images/ui/createaccount/button_startplaying
      $pressed:
        image-source: /images/ui/createaccount/button_startplaying_down
        text-offset: 1 1

    Button
      id: refreshCharactersButton
      anchors.right: cancelAssemblyButton.left
      anchors.bottom: parent.bottom
      margin-right: 6
      width: 96
      height: 24
      !text: tr('Refresh List')
      visible: false

ElementalBetaAccountWindow < MainWindow
  id: elementalBetaAccountWindow
  size: 480 520
  !text: tr('Account settings')
  @onEscape: CharacterList.closeAccountManagement()

  Panel
    id: accountPanel
    anchors.fill: parent
    margin: 12

    Label
      id: accountIntro
