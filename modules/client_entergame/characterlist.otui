    HiddenTextQtEdit
      id: passwordNewEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 1
      height: 22
      text-hidden: true

    Label
      anchors.left: parent.left
      anchors.top: passwordNewEdit.bottom
      margin-top: 3
      height: 16
      !text: tr('Repeat new password')

    HiddenTextQtEdit
      id: passwordConfirmEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 1
      height: 22
      text-hidden: true

    Button
      id: changePasswordButton
      anchors.left: parent.left
      anchors.top: passwordConfirmEdit.bottom
      margin-top: 4
      width: 170
      height: 24
      !text: tr('Change password')

    HorizontalSeparator
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: changePasswordButton.bottom
