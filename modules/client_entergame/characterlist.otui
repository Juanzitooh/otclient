      !text: tr('Current login email:')

    Label
      id: currentEmailValue
      anchors.left: parent.left
      anchors.top: accountIntro.bottom
      margin-top: 2
      height: 18
      color: #d7d7d7

    Label
      id: passwordSectionTitle
