Module
  name: game_crafting
  description: Elemental crafting interface
  sandboxed: true
  scripts: [ game_crafting ]
  autoload: true
  minClientVersion: 1525
  dependencies:
    - game_mainpanel
    - gamelib
    - game_skills
  @onLoad: GameCrafting:init()
  @onUnload: GameCrafting:terminate()
