AppearanceResultRow < Button
  height: 52
  text: ''
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top

  UISpriteEditorCanvas
    id: thumbnail
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 40 40

  Label
    id: appearanceResultName
    anchors.left: thumbnail.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 7
    margin-top: 5
    height: 18
    text-wrap: false

  Label
    id: appearanceId
    anchors.left: thumbnail.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 7
    margin-top: 27
    height: 18
    text-wrap: false

AppearanceFlagCheckBox < CheckBox
  height: 21
  text-wrap: false

AppearanceValueRow < Panel
  height: 24

  Label
    id: propertyLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    text-wrap: false

  TextEdit
    id: propertyValue
    anchors.left: propertyLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 20

AppearanceFrameDurationRow < Panel
  height: 27

  Label
    id: phaseLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 52
    text-wrap: false

  Label
    !text: tr('Min')
    anchors.left: phaseLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 25
    text-wrap: false

  TextEdit
    id: durationMin
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 58
    height: 20

  Label
    !text: tr('Max')
    anchors.left: durationMin.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    width: 27
    text-wrap: false

  TextEdit
    id: durationMax
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 58
    height: 20

SpriteEditorWindow < MainWindow
  id: spriteEditorWindow
  !text: tr('Offline Assets Editor')
  size: 1160 600
  @onEscape: modules.game_sprite_editor.requestClose()

  Label
    id: assetsLabel
    !text: tr('Client assets 15.x')
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: versionComboBox
    anchors.left: assetsLabel.right
    anchors.verticalCenter: assetsLabel.verticalCenter
    margin-left: 8
    width: 140
    height: 22

  Button
    id: openWorkCopyButton
    !text: tr('Open work copy')
    anchors.left: versionComboBox.right
    anchors.verticalCenter: versionComboBox.verticalCenter
    margin-left: 8
    width: 120
    @onClick: modules.game_sprite_editor.openWorkCopy()

  Label
    id: statusLabel
    !text: tr('Choose an installed 15.x asset version.')
    anchors.left: openWorkCopyButton.right
    anchors.right: parent.right
    anchors.verticalCenter: openWorkCopyButton.verticalCenter
    margin-left: 12
    text-wrap: true

  Panel
    id: pageNavigation
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: assetsLabel.bottom
    margin-top: 8
    height: 28

    Button
      id: editorPageButton
      !text: tr('Browse and edit')
      anchors.left: parent.left
      anchors.top: parent.top
      width: 150
      height: 26
      @onClick: modules.game_sprite_editor.showEditorPage()

    Button
      id: importPageButton
      !text: tr('Import and create')
      anchors.left: editorPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 150
      height: 26
      @onClick: modules.game_sprite_editor.showImportPage()

    Button
      id: exportPageButton
      !text: tr('Export work copy')
      anchors.left: importPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 140
      height: 26
      @onClick: modules.game_sprite_editor.showExportPage()

  Panel
    id: appearancesPanel
    anchors.left: parent.left
    anchors.top: pageNavigation.bottom
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 33
    width: 230

    Label
      !text: tr('Appearance category')
      anchors.left: parent.left
      anchors.top: parent.top

    ComboBox
      id: appearanceCategory
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    TextEdit
      id: appearanceSearch
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceCategory.bottom
      margin-top: 7
      height: 23
      !placeholder: tr('Search by name or ID')
      @onEnter: modules.game_sprite_editor.applyAppearanceSearch()

    Label
      id: appearanceResultsLabel
      !text: tr('Open a work copy to browse.')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceSearch.bottom
      margin-top: 6
      text-wrap: false

    UIScrollArea
      id: appearanceList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceResultsLabel.bottom
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 12
      vertical-scrollbar: appearanceListScroll
      auto-focus: none

      Panel
        id: appearanceListContent
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 1

    VerticalScrollBar
      id: appearanceListScroll
      anchors.top: appearanceList.top
      anchors.bottom: appearanceList.bottom
      anchors.right: parent.right
      step: 52
      pixels-scroll: true

  Panel
    id: editorCanvasFrame
    anchors.top: appearancesPanel.top
    anchors.left: appearancesPanel.right
    anchors.right: rightPanel.left
    anchors.bottom: appearancesPanel.bottom
    margin-left: 12
    margin-right: 12
    background-color: #242424

    UISpriteEditorCanvas
      id: canvas
      anchors.fill: parent
      margin: 4
      focusable: true

  Label
    id: spriteInfoLabel
    !text: tr('Select an appearance to preview its sprite.')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: editorCanvasFrame.top
    margin: 8
    text-wrap: true

  Label
    id: previewHintLabel
    !text: tr('1x | Wheel: zoom | Middle-drag: pan | Checkerboard: transparency')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin: 8
    text-wrap: true

  Panel
    id: previewControls
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: spriteInfoLabel.bottom
    margin-left: 8
    margin-right: 8
    margin-top: 4
    height: 74
    background-color: #242424
    visible: false

    Panel
      id: previewDirectionPad
      anchors.left: parent.left
      anchors.top: parent.top
      size: 150 68
      visible: false

      Button
        id: previewNorthWest
        !text: tr('NW')
        anchors.left: parent.left
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(7)

      Button
        id: previewNorth
        !text: tr('North')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(0)

      Button
        id: previewNorthEast
        !text: tr('NE')
        anchors.right: parent.right
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(4)

      Button
        id: previewWest
        !text: tr('West')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(3)

      Label
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Dir')
        text-align: center
        width: 48
        height: 21

      Button
        id: previewEast
        !text: tr('East')
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(1)

      Button
        id: previewSouthWest
        !text: tr('SW')
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(6)

      Button
        id: previewSouth
        !text: tr('South')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(2)

      Button
        id: previewSouthEast
        !text: tr('SE')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(5)

    Panel
      id: previewSettings
      anchors.left: previewDirectionPad.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 8

    ComboBox
      id: previewFrameGroup
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 94
      height: 21

    CheckBox
      id: previewMoving
      !text: tr('Moving')
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 90
      height: 21
      visible: false

    CheckBox
      id: previewMounted
      !text: tr('Mounted')
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 96
      width: 90
      height: 21
      visible: false

    ComboBox
      id: previewPatternX
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 94
      height: 21

    ComboBox
      id: previewPatternY
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 100
      width: 88
      height: 21

    ComboBox
      id: previewLayer
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 200
      width: 82
      height: 21

    ComboBox
      id: previewPatternZ
      anchors.left: previewSettings.left
      anchors.top: previewFrameGroup.bottom
      margin-top: 4
      width: 90
      height: 22

    Label
      id: previewPhaseLabel
      !text: tr('Frame')
      anchors.left: previewSettings.left
      anchors.top: previewPatternZ.bottom
      margin-top: 5
      width: 45
      height: 21

    SpinBox
      id: previewPhaseStepper
      anchors.left: previewPhaseLabel.right
      anchors.verticalCenter: previewPhaseLabel.verticalCenter
      width: 66
      height: 22
      minimum: 1
      maximum: 1
      text: 1

    Label
      id: previewPhaseCount
      anchors.left: previewPhaseStepper.right
      anchors.verticalCenter: previewPhaseStepper.verticalCenter
      margin-left: 4
      width: 46
      height: 21
      text-wrap: false

    Button
      id: replacePreviewSpriteButton
      !text: tr('Replace PNG...')
      anchors.left: previewPhaseCount.right
      anchors.verticalCenter: previewPhaseCount.verticalCenter
      margin-left: 5
      width: 116
      height: 23
      @onClick: modules.game_sprite_editor.quickReplacePreviewSprite()

  Panel
    id: rightPanel
    anchors.top: appearancesPanel.top
    anchors.right: parent.right
    anchors.bottom: appearancesPanel.bottom
    width: 320

    Panel
      id: propertiesPanel
      anchors.fill: parent

      Label
        id: appearanceInfoLabel
        !text: tr('Select an appearance from the list.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 23
        background-color: #603bb0
        color: #ffffff
        text-offset: 5 3
        text-wrap: false

      Label
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: appearanceInfoLabel.bottom
        margin-top: 7

      TextEdit
        id: appearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 22

      Label
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: appearanceName.bottom
        margin-top: 5

      TextEdit
        id: appearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 22

      Button
        id: flagsTabButton
        !text: tr('Flags')
        anchors.left: parent.left
        anchors.top: appearanceDescription.bottom
        margin-top: 8
        width: 100
        height: 24
        @onClick: modules.game_sprite_editor.showPropertiesTab('flags')

      Button
        id: valuesTabButton
        !text: tr('Values')
        anchors.left: flagsTabButton.right
        anchors.top: flagsTabButton.top
        margin-left: 4
        width: 100
        height: 24
        @onClick: modules.game_sprite_editor.showPropertiesTab('values')

      Button
        id: animationTabButton
        !text: tr('Animation')
        anchors.left: valuesTabButton.right
        anchors.right: parent.right
        anchors.top: flagsTabButton.top
        margin-left: 4
        height: 24
        @onClick: modules.game_sprite_editor.showPropertiesTab('animation')

      UIScrollArea
        id: appearanceFlagsList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: flagsTabButton.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceFlagsScroll
        layout: verticalBox
        padding: 3
        auto-focus: none

      VerticalScrollBar
        id: appearanceFlagsScroll
        anchors.top: appearanceFlagsList.top
        anchors.bottom: appearanceFlagsList.bottom
        anchors.right: parent.right
        step: 21
        pixels-scroll: true

      UIScrollArea
        id: appearanceValuesList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: flagsTabButton.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceValuesScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

      VerticalScrollBar
        id: appearanceValuesScroll
        anchors.top: appearanceValuesList.top
        anchors.bottom: appearanceValuesList.bottom
        anchors.right: parent.right
        step: 24
        pixels-scroll: true
        visible: false

      UIScrollArea
        id: appearanceAnimationPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: flagsTabButton.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceAnimationScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

        Label
          id: animationGroupInfo
          !text: tr('Select a frame group to edit its animation.')
          height: 33
          text-wrap: true

        Panel
          id: animationDefaultPhaseRow
          height: 25

          Label
            !text: tr('Default phase')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          TextEdit
            id: animationDefaultPhase
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 20

        CheckBox
          id: animationRandomStart
          !text: tr('Random start phase')
          height: 22

        CheckBox
          id: animationSynchronized
          !text: tr('Synchronized')
          height: 22

        Panel
          id: animationLoopTypeRow
          height: 25

          Label
            !text: tr('Loop type')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          ComboBox
            id: animationLoopType
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 22

        Panel
          id: animationLoopCountRow
          height: 25

          Label
            !text: tr('Loop count')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          TextEdit
            id: animationLoopCount
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 20

        Label
          !text: tr('Frame durations (milliseconds)')
          height: 20

        Panel
          id: animationFrameDurations
          layout: verticalBox
          height: 1

      VerticalScrollBar
        id: appearanceAnimationScroll
        anchors.top: appearanceAnimationPanel.top
        anchors.bottom: appearanceAnimationPanel.bottom
        anchors.right: parent.right
        step: 27
        pixels-scroll: true
        visible: false

      Label
        id: appearanceStatus
        !text: tr('Changes are saved to the work copy.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: saveAppearanceButton.top
        margin-bottom: 5
        height: 28
        text-wrap: true

      Button
        id: saveAppearanceButton
        !text: tr('Save appearance')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 26
        enabled: false
        @onClick: modules.game_sprite_editor.saveAppearanceProperties()

    Panel
      id: importPanel
      anchors.fill: parent
      visible: false

      Label
        !text: tr('Import prepared PNG')
        anchors.left: parent.left
        anchors.top: parent.top
        height: 23
        background-color: #603bb0
        color: #ffffff
        text-offset: 5 3

      Label
        id: selectedSpriteLabel
        !text: tr('Select a sprite in the editor first.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 7
        height: 44
        text-wrap: true

      Label
        !text: tr('PNG file path')
        anchors.left: parent.left
        anchors.top: selectedSpriteLabel.bottom
        margin-top: 8

      TextEdit
        id: imagePathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        height: 22
        !placeholder: tr('Paste the absolute path to a prepared PNG')

      Button
        id: replaceSpriteButton
        !text: tr('Replace target sprite')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: imagePathEdit.bottom
        margin-top: 6
        height: 25
        @onClick: modules.game_sprite_editor.replaceSprite()

      Label
        !text: tr('Create a new appearance')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: replaceSpriteButton.bottom
        margin-top: 18
        height: 23
        background-color: #603bb0
        color: #ffffff
        text-offset: 5 3

      Label
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 8

      TextEdit
        id: newAppearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        height: 22

      Label
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: newAppearanceName.bottom
        margin-top: 7

      TextEdit
        id: newAppearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        height: 22

      Button
        id: createAppearanceButton
        !text: tr('Create appearance from PNG')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: newAppearanceDescription.bottom
        margin-top: 7
        height: 26
        @onClick: modules.game_sprite_editor.createAppearance()

      Label
        !text: tr('New entries use one 32 x 32 sprite. Existing sprites must match their current dimensions.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: createAppearanceButton.bottom
        margin-top: 6
        height: 38
        text-wrap: true

    Panel
      id: exportPanel
      anchors.fill: parent
      visible: false

      Label
        !text: tr('Export the edited client assets')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 23
        background-color: #603bb0
        color: #ffffff
        text-offset: 5 3

      Label
        !text: tr('Export copies the work package to data/things/<version> under your chosen client folder. Existing packages are never overwritten.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 8
        height: 42
        text-wrap: true

      Label
        !text: tr('Current work copy')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 12

      Label
        id: activeWorkCopyLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 48
        text-wrap: true

      Label
        !text: tr('OTClient folder to receive the package')
        anchors.left: parent.left
        anchors.top: activeWorkCopyLabel.bottom
        margin-top: 8

      TextEdit
        id: exportPathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        height: 22
        !placeholder: tr('For example: /home/user/otclient')

      Button
        id: exportButton
        !text: tr('Export work package')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportPathEdit.bottom
        margin-top: 7
        height: 26
        @onClick: modules.game_sprite_editor.exportWorkCopy()

      Label
        id: exportStatus
        !text: tr('Choose a new destination folder. Existing folders are not overwritten.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportButton.bottom
        margin-top: 8
        height: 46
        text-wrap: true

  Button
    id: reloadButton
    !text: tr('Reload work copy')
    anchors.left: editorCanvasFrame.left
    anchors.bottom: parent.bottom
    width: 130
    height: 25
    @onClick: modules.game_sprite_editor.reloadPackage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 25
    @onClick: modules.game_sprite_editor.requestClose()

SpriteEditorWindow
