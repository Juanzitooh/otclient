AppearanceResultRow < Button
  height: 52
  text: ''
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top

  UISpriteEditorCanvas
    id: thumbnail
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 40 40

  Label
    id: appearanceId
    anchors.left: thumbnail.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    height: 22
    text-wrap: false

AppearanceSectionHeader < Label
  height: 23
  background-color: #603bb0
  color: #ffffff
  text-offset: 5 3
  text-wrap: false

AppearanceFieldLabel < Label
  height: 18
  text-offset: 0 2
  text-wrap: false

AppearanceTextEdit < TextEdit
  height: 22

AppearanceOptionCheckBox < CheckBox
  height: 21
  text-offset: 18 0
  text-wrap: false

AppearanceFlagCheckBox < AppearanceOptionCheckBox

AppearanceNavigationButton < Button
  height: 26

AppearanceActionButton < Button
  height: 26

AppearanceValueRow < Panel
  height: 24

  AppearanceFieldLabel
    id: propertyLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    text-wrap: false

  AppearanceTextEdit
    id: propertyValue
    anchors.left: propertyLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 20

AppearanceTimelineFrame < Button
  size: 28 22
  text-wrap: false

SpriteEditorWindow < MainWindow
  id: spriteEditorWindow
  !text: tr('Offline Assets Editor')
  size: 1160 600
  @onEscape: modules.game_sprite_editor.requestClose()

  Label
    id: assetsLabel
    !text: tr('Source version')
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: versionComboBox
    anchors.left: assetsLabel.right
    anchors.verticalCenter: assetsLabel.verticalCenter
    margin-left: 8
    width: 140
    height: 22

  Button
    id: openWorkCopyButton
    !text: tr('Open working copy')
    !tooltip: tr('Create or resume a work copy; installed assets stay unchanged.')
    anchors.left: versionComboBox.right
    anchors.verticalCenter: versionComboBox.verticalCenter
    margin-left: 8
    width: 142
    @onClick: modules.game_sprite_editor.openWorkCopy()

  Label
    id: statusLabel
    !text: tr('Choose an installed 15.x version, then open its safe working copy.')
    anchors.left: openWorkCopyButton.right
    anchors.right: parent.right
    anchors.verticalCenter: openWorkCopyButton.verticalCenter
    margin-left: 12
    text-wrap: true

  Panel
    id: pageNavigation
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: assetsLabel.bottom
    margin-top: 8
    height: 28

    AppearanceNavigationButton
      id: editorPageButton
      !text: tr('Browse')
      anchors.left: parent.left
      anchors.top: parent.top
      width: 150
      @onClick: modules.game_sprite_editor.showEditorPage()

    AppearanceNavigationButton
      id: importPageButton
      !text: tr('Import / create')
      anchors.left: editorPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 150
      @onClick: modules.game_sprite_editor.showImportPage()

    AppearanceNavigationButton
      id: exportPageButton
      !text: tr('Export package')
      anchors.left: importPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 140
      @onClick: modules.game_sprite_editor.showExportPage()

  Panel
    id: appearancesPanel
    anchors.left: parent.left
    anchors.top: pageNavigation.bottom
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 33
    width: 190

    Label
      !text: tr('Appearance category')
      anchors.left: parent.left
      anchors.top: parent.top

    ComboBox
      id: appearanceCategory
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    TextEdit
      id: appearanceSearch
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceCategory.bottom
      margin-top: 7
      height: 23
      !placeholder: tr('Search by name or ID')
      @onEnter: modules.game_sprite_editor.applyAppearanceSearch()

    Label
      id: appearanceResultsLabel
      !text: tr('Open a work copy to browse.')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceSearch.bottom
      margin-top: 6
      text-wrap: false

    UIScrollArea
      id: appearanceList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceResultsLabel.bottom
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 12
      vertical-scrollbar: appearanceListScroll
      auto-focus: none

      Panel
        id: appearanceListContent
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 1

    VerticalScrollBar
      id: appearanceListScroll
      anchors.top: appearanceList.top
      anchors.bottom: appearanceList.bottom
      anchors.right: parent.right
      step: 52
      pixels-scroll: true

  Panel
    id: editorCanvasFrame
    anchors.top: appearancesPanel.top
    anchors.left: appearancesPanel.right
    anchors.right: rightPanel.left
    anchors.bottom: appearancesPanel.bottom
    margin-left: 12
    margin-right: 12
    background-color: #242424

    UISpriteEditorCanvas
      id: canvas
      anchors.fill: parent
      margin: 4
      margin-bottom: 4
      focusable: true

  Label
    id: spriteInfoLabel
    !text: tr('Select an appearance to preview its sprite.')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: editorCanvasFrame.top
    margin: 8
    text-align: center
    text-wrap: true

  Label
    id: previewHintLabel
    !text: tr('1x | Wheel: zoom | Middle-drag: pan | Checkerboard: transparency')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    text-align: center
    text-wrap: true

  Panel
    id: previewControls
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 156
    background-color: #363636
    border-width: 1
    border-color: #4a4a4a
    visible: false

    Panel
      id: previewDirectionPad
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 8
      margin-top: 8
      size: 150 68
      visible: false

      Button
        id: previewNorthWest
        !text: tr('NW')
        anchors.left: parent.left
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(7)

      Button
        id: previewNorth
        !text: tr('North')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(0)

      Button
        id: previewNorthEast
        !text: tr('NE')
        anchors.right: parent.right
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(4)

      Button
        id: previewWest
        !text: tr('West')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(3)

      Label
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Dir')
        text-align: center
        width: 48
        height: 21

      Button
        id: previewEast
        !text: tr('East')
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(1)

      Button
        id: previewSouthWest
        !text: tr('SW')
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(6)

      Button
        id: previewSouth
        !text: tr('South')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(2)

      Button
        id: previewSouthEast
        !text: tr('SE')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(5)

    Panel
      id: previewSettings
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-right: 8
      margin-top: 8
      height: 1
      layout: verticalBox
      spacing: 4

      Panel
        id: previewMetaRow
        height: 22
        layout: horizontalBox
        spacing: 4

        ComboBox
          id: previewFrameGroup
          width: 112
          height: 22

        AppearanceOptionCheckBox
          id: previewMoving
          !text: tr('Moving')
          width: 88
          visible: false

        AppearanceOptionCheckBox
          id: previewMounted
          !text: tr('Mounted')
          width: 88
          visible: false

      Panel
        id: previewPatternRow
        height: 22
        layout: horizontalBox
        spacing: 4

        ComboBox
          id: previewPatternX
          width: 124
          height: 22

        ComboBox
          id: previewPatternY
          width: 124
          height: 22

        ComboBox
          id: previewLayer
          width: 100
          height: 22

        ComboBox
          id: previewPatternZ
          width: 124
          height: 22

      Panel
        id: previewAnimationSettingsRow
        height: 28
        visible: false

        Panel
          id: animationStartGroup
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          width: 104
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceFieldLabel
            !text: tr('Start')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 36
            height: 22
            tooltip: tr('Default starting frame for this animation.')

          AppearanceTextEdit
            id: animationDefaultPhase
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 3
            margin-right: 4
            width: 44
            height: 22

        Panel
          id: animationStartModeGroup
          anchors.left: animationStartGroup.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 6
          width: 158
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceOptionCheckBox
            id: animationRandomStart
            !text: tr('Random')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 73
            tooltip: tr('Start at a random frame.')

          AppearanceOptionCheckBox
            id: animationSynchronized
            !text: tr('Sync')
            anchors.left: animationRandomStart.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 1
            width: 68
            tooltip: tr('Synchronize this animation with other appearances.')

        Panel
          id: animationLoopGroup
          anchors.left: animationStartModeGroup.right
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 6
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          ComboBox
            id: animationLoopType
            anchors.left: parent.left
            anchors.right: animationLoopCountControls.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            margin-right: 4
            height: 22
            tooltip: tr('Animation loop type.')

          Panel
            id: animationLoopCountControls
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 4
            width: 100
            height: 22
            visible: false

            Label
              id: animationLoopCountLabel
              !text: tr('Count')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              width: 42
              height: 22
              text-wrap: false

            AppearanceTextEdit
              id: animationLoopCount
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              width: 48
              height: 22
              tooltip: tr('Number of loops when the loop type is Counted.')

    Panel
      id: previewTimelinePanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: previewSettings.bottom
      margin-left: 8
      margin-right: 8
      margin-top: 6
      height: 74

      Label
        id: previewTimelineLabel
        !text: tr('Frames')
        anchors.left: parent.left
        anchors.top: parent.top
        width: 50
        height: 22
        text-align: center
        text-wrap: false
        color: #dfdfdf

      UIScrollArea
        id: previewTimeline
        anchors.left: previewTimelineLabel.right
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 6
        height: 22
        horizontal-scrollbar: previewTimelineScroll
        auto-focus: none

        Panel
          id: previewTimelineFrames
          anchors.left: parent.left
          anchors.top: parent.top
          height: 22
          layout: horizontalBox
          spacing: 2

      HorizontalScrollBar
        id: previewTimelineScroll
        anchors.left: previewTimeline.left
        anchors.right: parent.right
        anchors.top: previewTimeline.bottom
        margin-top: 2
        height: 8
        pixels-scroll: true
        visible: false

      Panel
        id: previewAnimationFrameRow
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-bottom: 11
        height: 28

        Panel
          id: previewFrameSelectionGroup
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          width: 164
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceFieldLabel
            id: previewPhaseLabel
            !text: tr('Frame')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 42
            height: 22

          SpinBox
            id: previewPhaseStepper
            anchors.left: previewPhaseLabel.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 3
            width: 62
            height: 22
            minimum: 1
            maximum: 1
            text: 1

          Label
            id: previewPhaseCount
            anchors.left: previewPhaseStepper.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            margin-right: 4
            height: 22
            text-wrap: false

        Panel
          id: previewDurationGroup
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 0
          visible: false

          Panel
            id: animationDurationMinGroup
            anchors.left: parent.left
            anchors.right: parent.horizontalCenter
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-right: 3
            background-color: #303030
            border-width: 1
            border-color: #4a4a4a

            AppearanceFieldLabel
              id: animationDurationMinLabel
              !text: tr('Min ms')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 6
              width: 48
              height: 22

            AppearanceTextEdit
              id: animationDurationMin
              anchors.left: animationDurationMinLabel.right
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 4
              margin-right: 5
              height: 22

          Panel
            id: animationDurationMaxGroup
            anchors.left: parent.horizontalCenter
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-left: 3
            background-color: #303030
            border-width: 1
            border-color: #4a4a4a

            AppearanceFieldLabel
              id: animationDurationMaxLabel
              !text: tr('Max ms')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 6
              width: 48
              height: 22

            AppearanceTextEdit
              id: animationDurationMax
              anchors.left: animationDurationMaxLabel.right
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 4
              margin-right: 5
              height: 22

  Panel
    id: rightPanel
    anchors.top: appearancesPanel.top
    anchors.right: parent.right
    anchors.bottom: appearancesPanel.bottom
    width: 320

    Panel
      id: propertiesPanel
      anchors.fill: parent

      AppearanceSectionHeader
        id: appearanceInfoLabel
        !text: tr('Select an appearance from the list.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      AppearanceFieldLabel
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: appearanceInfoLabel.bottom
        margin-top: 7

      AppearanceTextEdit
        id: appearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      AppearanceFieldLabel
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: appearanceName.bottom
        margin-top: 5

      AppearanceTextEdit
        id: appearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      Panel
        id: spriteReplacementPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: appearanceDescription.bottom
        margin-top: 6
        height: 74
        visible: false

        AppearanceFieldLabel
          id: selectedSpriteLabel
          !text: tr('Select a linked sprite to replace its PNG.')
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          height: 19
          text-align: center
          text-wrap: true

        Panel
          id: previewSpritePathRow
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: selectedSpriteLabel.bottom
          margin-top: 2
          height: 22

          AppearanceTextEdit
            id: previewSpritePathEdit
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            !placeholder: tr('PNG path for import or edited sprite')
            !tooltip: tr('Enter an absolute PNG path for importing, or use Edit to create a temporary PNG.')

        Panel
          id: spriteActionRow
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: previewSpritePathRow.bottom
          margin-top: 4
          height: 22
          layout: horizontalBox

          AppearanceActionButton
            id: replaceAppearanceSpriteButton
            !text: tr('Replace')
            !tooltip: tr('Use another sprite ID or import a PNG as a new sprite.')
            width: 72
            height: 22
            margin-right: 4
            @onClick: modules.game_sprite_editor.replaceSprite()

          AppearanceActionButton
            id: editAppearanceSpriteButton
            !text: tr('Edit')
            !tooltip: tr('Open a safe PNG copy in the configured external sprite editor.')
            width: 58
            height: 22
            margin-right: 4
            @onClick: modules.game_sprite_editor.editSprite()

          AppearanceActionButton
            id: applyEditedSpriteButton
            !text: tr('Apply')
            width: 82
            height: 22
            margin-right: 4
            visible: false
            @onClick: modules.game_sprite_editor.applyEditedSprite()

          AppearanceActionButton
            id: configureSpriteEditorButton
            !text: tr('Editor...')
            !tooltip: tr('Choose the external editor executable or launcher.')
            width: 62
            height: 22
            @onClick: modules.game_sprite_editor.configureSpriteEditor()

      Panel
        id: propertiesTabBar
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: spriteReplacementPanel.bottom
        margin-top: 7
        height: 24
        layout: horizontalBox
        visible: false

        AppearanceNavigationButton
          id: flagsTabButton
          !text: tr('Flags')
          width: 96
          height: 24
          margin-right: 4
          @onClick: modules.game_sprite_editor.showPropertiesTab('flags')

        AppearanceNavigationButton
          id: valuesTabButton
          !text: tr('Values')
          width: 96
          height: 24
          margin-right: 4
          @onClick: modules.game_sprite_editor.showPropertiesTab('values')

      Label
        id: noPropertyOptionsLabel
        !text: tr('No flags or values for this appearance.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        margin-top: 4
        height: 21
        visible: false

      UIScrollArea
        id: appearanceFlagsList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceFlagsScroll
        layout: verticalBox
        padding: 3
        auto-focus: none

      VerticalScrollBar
        id: appearanceFlagsScroll
        anchors.top: appearanceFlagsList.top
        anchors.bottom: appearanceFlagsList.bottom
        anchors.right: parent.right
        step: 21
        pixels-scroll: true

      UIScrollArea
        id: appearanceValuesList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceValuesScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

      VerticalScrollBar
        id: appearanceValuesScroll
        anchors.top: appearanceValuesList.top
        anchors.bottom: appearanceValuesList.bottom
        anchors.right: parent.right
        step: 24
        pixels-scroll: true
        visible: false

      Label
        id: appearanceStatus
        !text: tr('Saved in the working copy.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: saveAppearanceButton.top
        margin-bottom: 5
        height: 28
        text-wrap: true

      AppearanceActionButton
        id: saveAppearanceButton
        !text: tr('Save changes')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 0
        visible: false
        enabled: false
        @onClick: modules.game_sprite_editor.saveAppearanceProperties()

    Panel
      id: importPanel
      anchors.fill: parent
      visible: false

      AppearanceSectionHeader
        !text: tr('Create an appearance from a prepared PNG')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      AppearanceFieldLabel
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 8

      AppearanceTextEdit
        id: newAppearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4

      AppearanceFieldLabel
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: newAppearanceName.bottom
        margin-top: 7

      AppearanceTextEdit
        id: newAppearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4

      AppearanceFieldLabel
        !text: tr('Prepared PNG path')
        anchors.left: parent.left
        anchors.top: newAppearanceDescription.bottom
        margin-top: 7

      AppearanceTextEdit
        id: newAppearancePngPathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        !placeholder: tr('Paste the absolute path to a prepared PNG')

      AppearanceActionButton
        id: createAppearanceButton
        !text: tr('Create appearance from PNG')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: newAppearancePngPathEdit.bottom
        margin-top: 7
        @onClick: modules.game_sprite_editor.createAppearance()

      Label
        !text: tr('New entries use one 32 x 32 sprite. Existing sprites must match their current dimensions.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: createAppearanceButton.bottom
        margin-top: 6
        height: 38
        text-wrap: true

    Panel
      id: exportPanel
      anchors.fill: parent
      visible: false

      AppearanceSectionHeader
        !text: tr('Export the edited client assets')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      Label
        !text: tr('Export creates data/things/<version> inside the destination root. It leaves installed assets untouched and never overwrites an existing package.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 8
        height: 42
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('Current work copy')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 12

      AppearanceFieldLabel
        id: activeWorkCopyLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 48
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('New destination root')
        anchors.left: parent.left
        anchors.top: activeWorkCopyLabel.bottom
        margin-top: 8

      AppearanceTextEdit
        id: exportPathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        !placeholder: tr('Choose or enter an absolute folder path')

      AppearanceActionButton
        id: exportButton
        !text: tr('Export to new folder')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportPathEdit.bottom
        margin-top: 7
        @onClick: modules.game_sprite_editor.exportWorkCopy()

      Label
        id: exportStatus
        !text: tr('Choose a new destination folder. Existing folders are not overwritten.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportButton.bottom
        margin-top: 8
        height: 46
        text-wrap: true

  AppearanceActionButton
    id: reloadButton
    !text: tr('Reload saved copy')
    anchors.left: editorCanvasFrame.left
    anchors.bottom: parent.bottom
    width: 130
    height: 25
    !tooltip: tr('Reload saved changes from the work copy, not installed assets.')
    @onClick: modules.game_sprite_editor.reloadPackage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 25
    @onClick: modules.game_sprite_editor.requestClose()

SpriteEditorWindow
