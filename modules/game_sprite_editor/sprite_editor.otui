AppearanceResultRow < Button
  height: 52
  text: ''
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top

  UISpriteEditorCanvas
    id: thumbnail
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 40 40

  Label
    id: appearanceId
    anchors.left: thumbnail.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    height: 22
    text-align: center
    text-wrap: false

SpritePickerCell < Button
  size: 70 60
  text: ''
  checkable: true
  draggable: true
  anchors.left: parent.left
  anchors.top: parent.top
  text-wrap: false

  UISpriteEditorCanvas
    id: thumbnail
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 1
    size: 32 32
    phantom: true

  Label
    id: spriteSizeBadge
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 2
    margin-right: 1
    size: 20 12
    text-align: right
    text-offset: 9 -10
    text-wrap: false
    font: small-9px
    color: #ffffff
    background-color: alpha
    phantom: true
    visible: false

  Label
    id: spritePickerId
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: thumbnail.bottom
    height: 17
    text-align: center
    text-wrap: false
    background-color: #242424
    phantom: true

  $on:
    image-clip: 0 20 43 20
    text-offset: 1 1

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 1

  $dragging:
    opacity: 0.8

AppearanceSectionHeader < Label
  height: 23
  background-color: #603bb0
  color: #ffffff
  text-offset: 5 3
  text-wrap: false

AppearanceCenteredSectionHeader < AppearanceSectionHeader
  text-align: center
  text-offset: 0 3

AppearanceFieldLabel < Label
  height: 18
  text-offset: 0 2
  text-wrap: false

AppearanceTextEdit < TextEdit
  height: 22

AppearanceCenteredNumberEdit < AppearanceTextEdit
  text-align: center

AppearanceOptionCheckBox < CheckBox
  height: 21
  text-offset: 18 0
  image-rect: 0 4 12 12
  text-wrap: false

AppearanceFlagCheckBox < AppearanceOptionCheckBox

AppearanceNavigationButton < Button
  height: 26

  $on:
    image-clip: 0 20 43 20
    text-offset: 1 1

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 1

AppearanceActionButton < Button
  height: 26

AppearanceValueRow < Panel
  height: 24

  AppearanceFieldLabel
    id: propertyLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    text-wrap: false

  AppearanceTextEdit
    id: propertyValue
    anchors.left: propertyLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 20

AppearanceValueSelectRow < Panel
  height: 24

  AppearanceFieldLabel
    id: propertyLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    text-wrap: false

  ComboBox
    id: propertySelection
    anchors.left: propertyLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 20

AppearanceTimelineFrame < Button
  size: 28 22
  text-wrap: false

  $on:
    image-clip: 0 20 43 20
    text-offset: 1 1

  $pressed:
    image-clip: 0 20 43 20
    text-offset: 1 1

AppearanceTimelineTrack < Panel
  size: 30 22

  Panel
    id: previewTimelineRail
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    height: 2
    background-color: #777777
    phantom: true

  Panel
    id: previewTimelineThumb
    size: 8 12
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.verticalCenter: parent.verticalCenter
    background-color: #d9c7ff
    border-width: 1
    border-color: #f1eaff
    phantom: true
    visible: false

AppearanceTimelineCell < Panel
  size: 30 48

  AppearanceTimelineFrame
    id: previewTimelineFrameButton
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 1

  AppearanceTimelineTrack
    id: previewTimelineTrack
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: previewTimelineFrameButton.bottom
    margin-top: 4

PreviewDirectionButton < Button
  size: 48 21
  checkable: true

  $checked:
    image-clip: 0 20 43 20
    text-offset: 1 1

SpriteEditorWindow < MainWindow
  id: spriteEditorWindow
  !text: tr('Offline Assets Editor')
  size: 1160 600
  @onEscape: modules.game_sprite_editor.requestClose()

  Label
    id: statusLabel
    !text: tr('Loading the work copy…')
    anchors.left: appearancesPanel.right
    anchors.right: pageNavigation.left
    anchors.verticalCenter: pageNavigation.verticalCenter
    margin-left: 12
    margin-right: 12
    text-wrap: true

  Panel
    id: pageNavigation
    anchors.right: parent.right
    anchors.top: parent.top
    width: 320
    height: 22
    layout: horizontalBox
    spacing: 4

    AppearanceNavigationButton
      id: editorPageButton
      !text: tr('Properties')
      !tooltip: tr('Edit the appearance name, description, flags, and values.')
      width: 104
      height: 22
      @onClick: modules.game_sprite_editor.showEditorPage()

    AppearanceNavigationButton
      id: importPageButton
      !text: tr('Import')
      !tooltip: tr('Replace or edit a frame sprite, or create an appearance from PNG.')
      width: 104
      height: 22
      @onClick: modules.game_sprite_editor.showImportPage()

    AppearanceNavigationButton
      id: exportPageButton
      !text: tr('Export')
      !tooltip: tr('Export the working copy as an asset package.')
      width: 104
      height: 22
      @onClick: modules.game_sprite_editor.showExportPage()

  Panel
    id: appearancesPanel
    anchors.left: parent.left
    anchors.top: pageNavigation.bottom
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 33
    width: 190

    Label
      id: assetsLabel
      !text: tr('Assets version')
      anchors.left: parent.left
      anchors.top: parent.top
      width: 90
      height: 22

    ComboBox
      id: versionComboBox
      anchors.left: assetsLabel.right
      anchors.right: parent.right
      anchors.verticalCenter: assetsLabel.verticalCenter
      margin-left: 4
      height: 22

    AppearanceActionButton
      id: loadAssetsButton
      !text: tr('Load assets')
      !tooltip: tr('Copy the selected installed version into a working copy, or reset its existing working copy from the installed assets.')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: assetsLabel.bottom
      margin-top: 3
      height: 24
      @onClick: modules.game_sprite_editor.loadSelectedAssets()

    AppearanceSectionHeader
      id: appearanceCategoryLabel
      !text: tr('Appearance category')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: loadAssetsButton.bottom
      margin-top: 7
      height: 23
      font: Verdana Bold-11px
      text-align: center
      text-offset: 0 3

    ComboBox
      id: appearanceCategory
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    UIScrollArea
      id: appearanceList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceCategory.bottom
      anchors.bottom: appearanceSearch.top
      margin-top: 6
      margin-bottom: 7
      margin-right: 12
      vertical-scrollbar: appearanceListScroll
      auto-focus: none

      Panel
        id: appearanceListContent
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 1
        focusable: false

    TextEdit
      id: appearanceSearch
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 23
      !placeholder: tr('Name or exact ID')
      !tooltip: tr('Numbers match an exact appearance ID. Text matches part of the name.')
      @onEnter: modules.game_sprite_editor.applyAppearanceSearch()

    VerticalScrollBar
      id: appearanceListScroll
      anchors.top: appearanceList.top
      anchors.bottom: appearanceList.bottom
      anchors.right: parent.right
      step: 52
      pixels-scroll: true

  Panel
    id: editorCanvasFrame
    anchors.top: appearancesPanel.top
    anchors.left: appearancesPanel.right
    anchors.right: rightPanel.left
    anchors.bottom: appearancesPanel.bottom
    margin-left: 12
    margin-right: 12
    background-color: #242424

    UISpriteEditorCanvas
      id: canvas
      anchors.fill: parent
      margin: 4
      margin-bottom: 4
      focusable: true

    Panel
      id: previewDirectionPad
      anchors.centerIn: canvas
      size: 176 122
      visible: false

      PreviewDirectionButton
        id: previewNorthWest
        !text: tr('NW')
        anchors.left: parent.left
        anchors.top: parent.top
        @onClick: modules.game_sprite_editor.selectPreviewDirection(7)

      PreviewDirectionButton
        id: previewNorth
        !text: tr('North')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        @onClick: modules.game_sprite_editor.selectPreviewDirection(0)

      PreviewDirectionButton
        id: previewNorthEast
        !text: tr('NE')
        anchors.right: parent.right
        anchors.top: parent.top
        @onClick: modules.game_sprite_editor.selectPreviewDirection(4)

      PreviewDirectionButton
        id: previewWest
        !text: tr('West')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_sprite_editor.selectPreviewDirection(3)

      PreviewDirectionButton
        id: previewEast
        !text: tr('East')
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: modules.game_sprite_editor.selectPreviewDirection(1)

      PreviewDirectionButton
        id: previewSouthWest
        !text: tr('SW')
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        @onClick: modules.game_sprite_editor.selectPreviewDirection(6)

      PreviewDirectionButton
        id: previewSouth
        !text: tr('South')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        @onClick: modules.game_sprite_editor.selectPreviewDirection(2)

      PreviewDirectionButton
        id: previewSouthEast
        !text: tr('SE')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        @onClick: modules.game_sprite_editor.selectPreviewDirection(5)

  Label
    id: spriteInfoLabel
    !text: tr('Select an appearance to see its sprite.')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: editorCanvasFrame.top
    margin-left: 8
    margin-right: 8
    margin-top: 6
    height: 18
    text-align: center
    text-wrap: false

  Label
    id: spriteContextLabel
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: spriteInfoLabel.bottom
    margin-left: 8
    margin-right: 8
    height: 18
    color: #c6c6c6
    text-align: center
    text-wrap: false
    visible: false

  Label
    id: previewHintLabel
    !text: tr('Wheel over preview: zoom | Middle-drag: pan | Checkerboard: transparency')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    text-align: center
    text-wrap: true

  Panel
    id: previewControls
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 156
    background-color: #363636
    border-width: 1
    border-color: #4a4a4a
    visible: false

    Panel
      id: previewTopControls
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-right: 8
      margin-top: 8
      height: 1
      layout: verticalBox
      spacing: 4

      Panel
        id: previewMetaRow
        height: 22
        layout: horizontalBox
        spacing: 4

        ComboBox
          id: previewFrameGroup
          width: 112
          height: 22

        AppearanceOptionCheckBox
          id: previewMoving
          !text: tr('Moving')
          width: 88
          visible: false

        AppearanceOptionCheckBox
          id: previewMounted
          !text: tr('Mounted')
          width: 88
          visible: false

      Panel
        id: previewPatternRow
        height: 22
        layout:
          type: horizontalBox
          spacing: 10

        ComboBox
          id: previewPatternX
          width: 124
          height: 22

        ComboBox
          id: previewPatternY
          width: 124
          height: 22

        ComboBox
          id: previewLayer
          width: 100
          height: 22

        ComboBox
          id: previewPatternZ
          width: 124
          height: 22

      Panel
        id: previewAnimationSettingsRow
        height: 28
        visible: false

        Panel
          id: animationStartGroup
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          width: 104
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceFieldLabel
            !text: tr('Start')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 36
            height: 22
            tooltip: tr('Default starting frame for this animation.')

          AppearanceTextEdit
            id: animationDefaultPhase
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 3
            margin-right: 4
            width: 44
            height: 22

        Panel
          id: animationStartModeGroup
          anchors.left: animationStartGroup.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 6
          width: 158
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceOptionCheckBox
            id: animationRandomStart
            !text: tr('Random')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 73
            tooltip: tr('Start at a random frame.')

          AppearanceOptionCheckBox
            id: animationSynchronized
            !text: tr('Sync')
            anchors.left: animationRandomStart.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 1
            width: 68
            tooltip: tr('Synchronize this animation with other appearances.')

        Panel
          id: animationLoopGroup
          anchors.left: animationStartModeGroup.right
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 6
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          ComboBox
            id: animationLoopType
            anchors.left: parent.left
            anchors.right: animationLoopCountControls.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            margin-right: 4
            height: 22
            tooltip: tr('Animation loop type.')

          Panel
            id: animationLoopCountControls
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-right: 4
            width: 100
            height: 22
            visible: false

            Label
              id: animationLoopCountLabel
              !text: tr('Count')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              width: 42
              height: 22
              text-wrap: false

            AppearanceTextEdit
              id: animationLoopCount
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              width: 48
              height: 22
              tooltip: tr('Number of loops when the loop type is Counted.')

    Panel
      id: previewTimelinePanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: previewTopControls.bottom
      margin-left: 8
      margin-right: 8
      margin-top: 6
      height: 100

      Label
        id: previewTimelineLabel
        !text: tr('Frames')
        anchors.left: parent.left
        anchors.top: parent.top
        width: 50
        height: 22
        text-align: center
        text-wrap: false
        color: #dfdfdf

      UIScrollArea
        id: previewTimeline
        anchors.left: previewTimelineLabel.right
        anchors.right: previewPhaseActions.left
        anchors.top: parent.top
        margin-left: 6
        margin-right: 4
        height: 48
        horizontal-scrollbar: previewTimelineScroll
        auto-focus: none

        Panel
          id: previewTimelineFrames
          anchors.left: parent.left
          anchors.top: parent.top
          height: 48
          layout: horizontalBox
          spacing: 0

      Panel
        id: previewPhaseActions
        anchors.right: parent.right
        anchors.top: parent.top
        size: 104 22
        layout: horizontalBox
        spacing: 2

        AppearanceActionButton
          id: previewPlayButton
          !text: tr('Play')
          size: 48 22
          !tooltip: tr('Play the animation preview from the selected frame.')
          @onClick: modules.game_sprite_editor.togglePreviewAnimation()

        AppearanceActionButton
          id: removeAnimationFrameButton
          !text: tr('-')
          size: 25 22
          !tooltip: tr('Remove the last frame and its sprite links.')

        AppearanceActionButton
          id: addAnimationFrameButton
          !text: tr('+')
          size: 25 22
          !tooltip: tr('Add a frame by copying the last frame.')

      HorizontalScrollBar
        id: previewTimelineScroll
        anchors.left: previewTimeline.left
        anchors.right: previewPhaseActions.left
        anchors.top: previewTimeline.bottom
        margin-top: 2
        margin-right: 4
        height: 8
        pixels-scroll: true
        visible: false

      Panel
        id: previewAnimationFrameRow
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-bottom: 11
        height: 28

        Panel
          id: previewFrameSelectionGroup
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          width: 164
          background-color: #303030
          border-width: 1
          border-color: #4a4a4a

          AppearanceFieldLabel
            id: previewPhaseLabel
            !text: tr('Frame')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 5
            width: 42
            height: 22

          SpinBox
            id: previewPhaseStepper
            anchors.left: previewPhaseLabel.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 3
            width: 62
            height: 22
            minimum: 1
            maximum: 1
            text: 1

          Label
            id: previewPhaseCount
            anchors.left: previewPhaseStepper.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            margin-left: 4
            margin-right: 4
            height: 22
            text-wrap: false

        Panel
          id: previewDurationGroup
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom
          margin-left: 0
          visible: false

          Panel
            id: animationDurationMinGroup
            anchors.left: parent.left
            anchors.right: parent.horizontalCenter
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-right: 3
            background-color: #303030
            border-width: 1
            border-color: #4a4a4a

            AppearanceFieldLabel
              id: animationDurationMinLabel
              !text: tr('Min ms')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 6
              width: 48
              height: 22

            AppearanceCenteredNumberEdit
              id: animationDurationMin
              anchors.left: animationDurationMinLabel.right
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 4
              margin-right: 5
              height: 22

          Panel
            id: animationDurationMaxGroup
            anchors.left: parent.horizontalCenter
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            margin-left: 3
            background-color: #303030
            border-width: 1
            border-color: #4a4a4a

            AppearanceFieldLabel
              id: animationDurationMaxLabel
              !text: tr('Max ms')
              anchors.left: parent.left
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 6
              width: 48
              height: 22

            AppearanceCenteredNumberEdit
              id: animationDurationMax
              anchors.left: animationDurationMaxLabel.right
              anchors.right: parent.right
              anchors.verticalCenter: parent.verticalCenter
              margin-left: 4
              margin-right: 5
              height: 22

  Panel
    id: rightPanel
    anchors.top: pageNavigation.bottom
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 33
    width: 320

    Panel
      id: propertiesPanel
      anchors.fill: parent

      AppearanceSectionHeader
        id: appearanceInfoLabel
        !text: tr('Select an appearance from the list.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      AppearanceFieldLabel
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: appearanceInfoLabel.bottom
        margin-top: 7

      AppearanceTextEdit
        id: appearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      AppearanceFieldLabel
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: appearanceName.bottom
        margin-top: 5

      AppearanceTextEdit
        id: appearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      Panel
        id: propertiesTabBar
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: appearanceDescription.bottom
        margin-top: 7
        height: 24
        layout: horizontalBox
        spacing: 4
        visible: false

        AppearanceNavigationButton
          id: flagsTabButton
          !text: tr('Flags')
          width: 158
          height: 24
          @onClick: modules.game_sprite_editor.showPropertiesTab('flags')

        AppearanceNavigationButton
          id: valuesTabButton
          !text: tr('Values')
          width: 158
          height: 24
          @onClick: modules.game_sprite_editor.showPropertiesTab('values')

      Label
        id: noPropertyOptionsLabel
        !text: tr('No flags or values for this appearance.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        margin-top: 4
        height: 21
        visible: false

      UIScrollArea
        id: appearanceFlagsList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceFlagsScroll
        layout: verticalBox
        padding: 3
        auto-focus: none

      VerticalScrollBar
        id: appearanceFlagsScroll
        anchors.top: appearanceFlagsList.top
        anchors.bottom: appearanceFlagsList.bottom
        anchors.right: parent.right
        step: 21
        pixels-scroll: true

      UIScrollArea
        id: appearanceValuesList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceValuesScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

      VerticalScrollBar
        id: appearanceValuesScroll
        anchors.top: appearanceValuesList.top
        anchors.bottom: appearanceValuesList.bottom
        anchors.right: parent.right
        step: 24
        pixels-scroll: true
        visible: false

      Label
        id: appearanceStatus
        !text: tr('Saved in the working copy.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: saveAppearanceButton.top
        margin-bottom: 5
        height: 28
        text-wrap: true

      AppearanceActionButton
        id: saveAppearanceButton
        !text: tr('Save changes')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 0
        visible: false
        enabled: false
        @onClick: modules.game_sprite_editor.saveAppearanceProperties()

    Panel
      id: importPanel
      anchors.fill: parent
      visible: false

      AppearanceCenteredSectionHeader
        !text: tr('Import and edit sprites')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      Panel
        id: importActionTabs
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 5
        height: 24
        layout: horizontalBox
        spacing: 5

        AppearanceNavigationButton
          id: replaceFrameTabButton
          !text: tr('Replace frame')
          width: 148
          height: 24
          @onClick: modules.game_sprite_editor.setImportSection('replace')

        AppearanceNavigationButton
          id: newAppearanceTabButton
          !text: tr('New appearance')
          width: 148
          height: 24
          @onClick: modules.game_sprite_editor.setImportSection('create')

      Panel
        id: replaceFramePanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: importActionTabs.bottom
        anchors.bottom: parent.bottom
        margin-top: 5
        visible: false

        AppearanceFieldLabel
          id: selectedSpriteTargetLabel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          margin-top: 2
          height: 18
          text-wrap: false

        Panel
          id: replaceSourceModes
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: selectedSpriteTargetLabel.bottom
          margin-top: 3
          height: 23
          layout: horizontalBox
          spacing: 4

          AppearanceNavigationButton
            id: spriteIdModeButton
            !text: tr('Sprite ID')
            width: 94
            height: 23
            @onClick: modules.game_sprite_editor.setReplaceMode('sprite')

          AppearanceNavigationButton
            id: pngModeButton
            !text: tr('Import PNG')
            width: 94
            height: 23
            @onClick: modules.game_sprite_editor.setReplaceMode('png')

        Panel
          id: spriteIdReplacePanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: replaceSourceModes.bottom
          anchors.bottom: editCurrentSpritePanel.top
          margin-top: 4
          margin-bottom: 8
          visible: false

          AppearanceTextEdit
            id: spriteSearchEdit
            anchors.left: parent.left
            anchors.right: spritePickerCountLabel.left
            anchors.top: parent.top
            margin-right: 5
            height: 22
            !placeholder: tr('Search sprite ID')

          AppearanceFieldLabel
            id: spritePickerCountLabel
            anchors.right: parent.right
            anchors.top: parent.top
            width: 104
            height: 22
            text-align: right

          UIScrollArea
            id: spritePickerList
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: spriteSearchEdit.bottom
            anchors.bottom: selectedReplacementSpriteLabel.top
            margin-top: 4
            margin-bottom: 3
            vertical-scrollbar: spritePickerScroll
            auto-focus: none

            Panel
              id: spritePickerContent
              anchors.left: parent.left
              anchors.right: parent.right
              anchors.top: parent.top
              height: 1
              focusable: false

          AppearanceFieldLabel
            id: selectedReplacementSpriteLabel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            height: 23
            text-wrap: false
            !text: tr('Drag a sprite onto the preview to replace this frame.')
            !tooltip: tr('Drag a sprite from this list onto the center preview to replace the selected frame.')

          VerticalScrollBar
            id: spritePickerScroll
            anchors.top: spritePickerList.top
            anchors.bottom: spritePickerList.bottom
            anchors.right: spritePickerList.right
            step: 60
            pixels-scroll: true

        Panel
          id: pngReplacePanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: replaceSourceModes.bottom
          anchors.bottom: editCurrentSpritePanel.top
          margin-top: 4
          margin-bottom: 8
          visible: false

          Label
            id: replacePngHelpLabel
            !text: tr('The PNG is added as a new sprite ID and linked to this frame only.')
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 34
            text-wrap: true

          AppearanceTextEdit
            id: previewSpritePathEdit
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: replacePngHelpLabel.bottom
            margin-top: 4
            margin-right: 86
            height: 22
            !placeholder: tr('Path to a prepared PNG')
            !tooltip: tr('Choose a PNG file or enter its path, then import it as a new sprite ID for this frame.')

          AppearanceActionButton
            id: browsePngButton
            !text: tr('Browse...')
            anchors.right: parent.right
            anchors.top: replacePngHelpLabel.bottom
            margin-top: 4
            width: 82
            height: 22
            @onClick: modules.game_sprite_editor.openPngFilePicker()

          AppearanceActionButton
            id: importPngReplaceButton
            !text: tr('Import PNG and replace frame')
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: browsePngButton.bottom
            margin-top: 5
            height: 24
            @onClick: modules.game_sprite_editor.importPngAndReplace()

        Panel
          id: editCurrentSpritePanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          height: 91
          background-color: #363636
          border-width: 1
          border-color: #4a4a4a

          AppearanceCenteredSectionHeader
            !text: tr('Edit current sprite')
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top

          Label
            id: spriteEditHelpLabel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-left: 5
            margin-right: 5
            margin-top: 3
            height: 27
            text-wrap: true

          Panel
            id: spriteEditActionRow
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            margin-left: 5
            margin-right: 5
            margin-bottom: 4
            height: 23
            layout: horizontalBox
            spacing: 4

            AppearanceActionButton
              id: editAppearanceSpriteButton
              !text: tr('Edit sprite')
              !tooltip: tr('Open a safe PNG copy of this sprite in the configured editor.')
              width: 88
              height: 23
              @onClick: modules.game_sprite_editor.editSprite()

            AppearanceActionButton
              id: applyEditedSpriteButton
              !text: tr('Apply edit')
              width: 88
              height: 23
              visible: false
              @onClick: modules.game_sprite_editor.applyEditedSprite()

            AppearanceActionButton
              id: configureSpriteEditorButton
              !text: tr('Choose app')
              !tooltip: tr('Choose the external editor executable or launcher.')
              width: 88
              height: 23
              @onClick: modules.game_sprite_editor.configureSpriteEditor()

      Panel
        id: newAppearancePanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: importActionTabs.bottom
        anchors.bottom: parent.bottom
        margin-top: 5
        visible: false

        AppearanceCenteredSectionHeader
          !text: tr('Create a new appearance')
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top

        AppearanceFieldLabel
          !text: tr('Category')
          anchors.left: parent.left
          anchors.top: prev.bottom
          margin-top: 8

        ComboBox
          id: newAppearanceCategory
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: prev.bottom
          margin-top: 4
          height: 22

        Panel
          id: newAppearanceSourceModes
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: newAppearanceCategory.bottom
          margin-top: 7
          height: 23
          layout: horizontalBox
          spacing: 4

          AppearanceNavigationButton
            id: newAppearanceSpriteModeButton
            !text: tr('Sprite ID')
            width: 148
            height: 23
            @onClick: modules.game_sprite_editor.setNewAppearanceSourceMode('sprite')

          AppearanceNavigationButton
            id: newAppearancePngModeButton
            !text: tr('Import PNG')
            width: 148
            height: 23
            @onClick: modules.game_sprite_editor.setNewAppearanceSourceMode('png')

        Panel
          id: newAppearanceSpritePanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: newAppearanceSourceModes.bottom
          anchors.bottom: newAppearanceSourceHintLabel.top
          margin-top: 5
          margin-bottom: 3
          visible: false

          AppearanceTextEdit
            id: newAppearanceSpriteSearchEdit
            anchors.left: parent.left
            anchors.right: newAppearanceSpritePickerCountLabel.left
            anchors.top: parent.top
            margin-right: 5
            height: 22
            !placeholder: tr('Search sprite ID')

          AppearanceFieldLabel
            id: newAppearanceSpritePickerCountLabel
            anchors.right: parent.right
            anchors.top: parent.top
            width: 104
            height: 22
            text-align: right

          UIScrollArea
            id: newAppearanceSpritePickerList
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: newAppearanceSpriteSearchEdit.bottom
            anchors.bottom: newAppearanceSelectedSpriteLabel.top
            margin-top: 4
            margin-bottom: 3
            vertical-scrollbar: newAppearanceSpritePickerScroll
            auto-focus: none

            Panel
              id: newAppearanceSpritePickerContent
              anchors.left: parent.left
              anchors.right: parent.right
              anchors.top: parent.top
              height: 1
              focusable: false

          AppearanceFieldLabel
            id: newAppearanceSelectedSpriteLabel
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            height: 23
            text-wrap: false

          VerticalScrollBar
            id: newAppearanceSpritePickerScroll
            anchors.top: newAppearanceSpritePickerList.top
            anchors.bottom: newAppearanceSpritePickerList.bottom
            anchors.right: newAppearanceSpritePickerList.right
            step: 60
            pixels-scroll: true

        Panel
          id: newAppearancePngPanel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: newAppearanceSourceModes.bottom
          anchors.bottom: newAppearanceSourceHintLabel.top
          margin-top: 8
          margin-bottom: 3
          visible: false

          Label
            !text: tr('A prepared PNG is added as a new sprite ID for this appearance.')
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            height: 36
            text-wrap: true

          AppearanceTextEdit
            id: newAppearancePngPathEdit
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: prev.bottom
            margin-top: 5
            margin-right: 86
            height: 22
            !placeholder: tr('Choose a prepared PNG')

          AppearanceActionButton
            id: browseNewAppearancePngButton
            !text: tr('Browse...')
            anchors.right: parent.right
            anchors.top: newAppearancePngPathEdit.top
            width: 82
            height: 22
            @onClick: modules.game_sprite_editor.openPngFilePicker('create')

        Label
          id: newAppearanceSourceHintLabel
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: createAppearanceButton.top
          margin-bottom: 4
          height: 30
          text-wrap: true

        AppearanceActionButton
          id: createAppearanceButton
          !text: tr('Create appearance')
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-bottom: 2
          height: 24
          @onClick: modules.game_sprite_editor.createAppearance()

    Panel
      id: exportPanel
      anchors.fill: parent
      visible: false

      AppearanceCenteredSectionHeader
        !text: tr('Install the edited client assets')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      Label
        !text: tr('Install replaces the selected package in data/things. The previous package is moved to data/things/backup first. The editor then reloads appearances and static data for offline testing.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 8
        height: 54
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('Working copy')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 10

      AppearanceFieldLabel
        id: activeWorkCopyLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 48
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('Install location')
        anchors.left: parent.left
        anchors.top: activeWorkCopyLabel.bottom
        margin-top: 8

      AppearanceFieldLabel
        id: installTargetLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        height: 24
        text-wrap: false

      AppearanceActionButton
        id: exportButton
        !text: tr('Export and replace assets')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: installTargetLabel.bottom
        margin-top: 7
        height: 25
        @onClick: modules.game_sprite_editor.exportWorkCopy()

      Label
        id: exportStatus
        !text: tr('The installed package will be backed up before it is replaced.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportButton.bottom
        margin-top: 8
        height: 58
        text-wrap: true

  AppearanceActionButton
    id: reloadButton
    !text: tr('Reload saved copy')
    anchors.left: editorCanvasFrame.left
    anchors.bottom: parent.bottom
    width: 130
    height: 25
    !tooltip: tr('Reload the saved working copy from disk, including appearances and static data. This does not reset it from installed assets.')
    @onClick: modules.game_sprite_editor.reloadPackage()

  AppearanceActionButton
    id: duplicateAppearanceButton
    !text: tr('Duplicate')
    !tooltip: tr('Copy flags, values, animation, and sprite links to a new ID. Sprite IDs stay shared until replaced.')
    anchors.left: appearancesPanel.left
    anchors.bottom: parent.bottom
    width: 91
    height: 25
    @onClick: modules.game_sprite_editor.duplicateSelectedAppearance()

  AppearanceActionButton
    id: createAppearanceShortcutButton
    !text: tr('+ New')
    !tooltip: tr('Create an appearance from a PNG or an existing sprite ID.')
    anchors.right: appearancesPanel.right
    anchors.bottom: parent.bottom
    width: 91
    height: 25
    @onClick: modules.game_sprite_editor.openNewAppearance()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 25
    @onClick: modules.game_sprite_editor.requestClose()

SpriteEditorWindow
