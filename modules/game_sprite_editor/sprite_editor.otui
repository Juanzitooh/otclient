SpriteEditorWindow < MainWindow
  id: spriteEditorWindow
  !text: tr('Offline Assets Editor')
  size: 1160 700
  @onEscape: modules.game_sprite_editor.requestClose()

  Label
    id: assetsLabel
    !text: tr('Client assets 15.x')
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: versionComboBox
    anchors.left: assetsLabel.right
    anchors.verticalCenter: assetsLabel.verticalCenter
    margin-left: 8
    width: 140
    height: 22

  Button
    id: openWorkCopyButton
    !text: tr('Open work copy')
    anchors.left: versionComboBox.right
    anchors.verticalCenter: versionComboBox.verticalCenter
    margin-left: 8
    width: 120
    @onClick: modules.game_sprite_editor.openWorkCopy()

  Label
    id: statusLabel
    !text: tr('Choose an installed 15.x asset version.')
    anchors.left: openWorkCopyButton.right
    anchors.right: parent.right
    anchors.verticalCenter: openWorkCopyButton.verticalCenter
    margin-left: 12
    text-wrap: true

  Panel
    id: appearancesPanel
    anchors.left: parent.left
    anchors.top: assetsLabel.bottom
    anchors.bottom: closeButton.top
    margin-top: 12
    margin-bottom: 8
    width: 220

    Label
      !text: tr('Appearance category')
      anchors.left: parent.left
      anchors.top: parent.top

    ComboBox
      id: appearanceCategory
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    Label
      !text: tr('Appearance ID')
      anchors.left: parent.left
      anchors.top: appearanceCategory.bottom
      margin-top: 9

    TextEdit
      id: appearanceIdEdit
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 4
      width: 110
      height: 22
      @onEnter: modules.game_sprite_editor.loadAppearanceFromMain()

    Button
      !text: tr('Load')
      anchors.left: appearanceIdEdit.right
      anchors.verticalCenter: appearanceIdEdit.verticalCenter
      margin-left: 6
      width: 70
      @onClick: modules.game_sprite_editor.loadAppearanceFromMain()

    Label
      id: appearanceInfoLabel
      text: tr('No appearance loaded')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceIdEdit.bottom
      margin-top: 5
      text-wrap: true

    Label
      id: spriteListHeader
      !text: tr('Linked sprites')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceInfoLabel.bottom
      margin-top: 10
      height: 22
      background-color: #603bb0
      color: #ffffff
      text-offset: 5 3

    UIScrollArea
      id: assetSpriteList
      anchors.left: parent.left
      anchors.right: assetSpriteScroll.left
      anchors.top: spriteListHeader.bottom
      anchors.bottom: appearancePropertiesButton.top
      margin-top: 4
      margin-bottom: 8
      vertical-scrollbar: assetSpriteScroll
      layout: verticalBox
      padding: 2
      auto-focus: none

    VerticalScrollBar
      id: assetSpriteScroll
      anchors.top: assetSpriteList.top
      anchors.bottom: assetSpriteList.bottom
      anchors.right: parent.right
      step: 24
      pixels-scroll: true

    Button
      id: appearancePropertiesButton
      !text: tr('Appearance properties')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 25
      @onClick: modules.game_sprite_editor.openAppearanceEditor()

  Panel
    id: editorCanvasFrame
    anchors.top: appearancesPanel.top
    anchors.left: appearancesPanel.right
    anchors.right: importPanel.left
    anchors.bottom: appearancesPanel.bottom
    margin-left: 12
    margin-right: 12
    background-color: #242424

    UISpriteEditorCanvas
      id: canvas
      anchors.fill: parent
      margin: 4
      focusable: true

  Label
    id: spriteInfoLabel
    text: tr('No sprite selected')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: editorCanvasFrame.top
    margin: 8
    text-wrap: true

  Label
    id: previewHintLabel
    !text: tr('Preview only | Wheel: zoom | Middle-drag: pan | Transparent pixels use the checkerboard.')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin: 8
    text-wrap: true

  Panel
    id: importPanel
    anchors.top: appearancesPanel.top
    anchors.right: parent.right
    anchors.bottom: appearancesPanel.bottom
    width: 300

    Label
      !text: tr('Import prepared PNG')
      anchors.left: parent.left
      anchors.top: parent.top
      height: 22
      background-color: #603bb0
      color: #ffffff
      text-offset: 5 3

    Label
      !text: tr('Sprite ID to replace')
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 8

    TextEdit
      id: spriteIdEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22
      @onEnter: modules.game_sprite_editor.loadSpriteId()

    Button
      !text: tr('Preview selected sprite')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: spriteIdEdit.bottom
      margin-top: 5
      height: 24
      @onClick: modules.game_sprite_editor.loadSpriteId()

    Label
      !text: tr('Absolute path to PNG')
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 9

    TextEdit
      id: imagePathEdit
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    Button
      id: replaceSpriteButton
      !text: tr('Replace selected sprite')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: imagePathEdit.bottom
      margin-top: 5
      height: 24
      @onClick: modules.game_sprite_editor.replaceSprite()

    Label
      !text: tr('Create a new appearance')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: replaceSpriteButton.bottom
      margin-top: 18
      height: 22
      background-color: #603bb0
      color: #ffffff
      text-offset: 5 3

    Label
      !text: tr('Name')
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 8

    TextEdit
      id: newAppearanceName
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    Label
      !text: tr('Description')
      anchors.left: parent.left
      anchors.top: newAppearanceName.bottom
      margin-top: 7

    TextEdit
      id: newAppearanceDescription
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    Button
      id: createAppearanceButton
      !text: tr('Create from prepared PNG')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: newAppearanceDescription.bottom
      margin-top: 7
      height: 25
      @onClick: modules.game_sprite_editor.createAppearance()

    Label
      !text: tr('New entries use one 32 x 32 sprite. Existing sprites must match their current dimensions.')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: createAppearanceButton.bottom
      margin-top: 5
      text-wrap: true

    Label
      !text: tr('Zoom')
      anchors.left: parent.left
      anchors.bottom: zoomOutButton.top
      margin-bottom: 5

    Button
      id: zoomOutButton
      text: '-'
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 40
      height: 24
      @onClick: modules.game_sprite_editor.zoomOut()

    Label
      id: zoomLabel
      text: 1x
      anchors.left: zoomOutButton.right
      anchors.right: zoomInButton.left
      anchors.verticalCenter: zoomOutButton.verticalCenter
      text-align: center

    Button
      id: zoomInButton
      text: '+'
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      width: 40
      height: 24
      @onClick: modules.game_sprite_editor.zoomIn()

  Button
    id: reloadButton
    !text: tr('Reload work copy')
    anchors.left: editorCanvasFrame.left
    anchors.bottom: parent.bottom
    width: 130
    height: 25
    @onClick: modules.game_sprite_editor.reloadPackage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 25
    @onClick: modules.game_sprite_editor.requestClose()
