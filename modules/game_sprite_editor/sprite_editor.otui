AppearanceResultRow < Button
  height: 52
  text: ''
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top

  UISpriteEditorCanvas
    id: thumbnail
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    size: 40 40

  Label
    id: appearanceId
    anchors.left: thumbnail.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    height: 22
    text-wrap: false

AppearanceSectionHeader < Label
  height: 23
  background-color: #603bb0
  color: #ffffff
  text-offset: 5 3
  text-wrap: false

AppearanceFieldLabel < Label
  height: 18
  text-offset: 0 2
  text-wrap: false

AppearanceTextEdit < TextEdit
  height: 22

AppearanceOptionCheckBox < CheckBox
  height: 21
  text-offset: 18 0
  text-wrap: false

AppearanceFlagCheckBox < AppearanceOptionCheckBox

AppearanceNavigationButton < Button
  height: 26

AppearanceActionButton < Button
  height: 26

AppearanceValueRow < Panel
  height: 24

  AppearanceFieldLabel
    id: propertyLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 145
    text-wrap: false

  AppearanceTextEdit
    id: propertyValue
    anchors.left: propertyLabel.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    height: 20

AppearanceFrameDurationRow < Panel
  height: 27

  Label
    id: phaseLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    width: 52
    text-wrap: false

  Label
    !text: tr('Min')
    anchors.left: phaseLabel.right
    anchors.verticalCenter: parent.verticalCenter
    width: 25
    text-wrap: false

  TextEdit
    id: durationMin
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 58
    height: 20

  Label
    !text: tr('Max')
    anchors.left: durationMin.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    width: 27
    text-wrap: false

  TextEdit
    id: durationMax
    anchors.left: prev.right
    anchors.verticalCenter: parent.verticalCenter
    width: 58
    height: 20

SpriteEditorWindow < MainWindow
  id: spriteEditorWindow
  !text: tr('Offline Assets Editor')
  size: 1160 600
  @onEscape: modules.game_sprite_editor.requestClose()

  Label
    id: assetsLabel
    !text: tr('Source version')
    anchors.left: parent.left
    anchors.top: parent.top

  ComboBox
    id: versionComboBox
    anchors.left: assetsLabel.right
    anchors.verticalCenter: assetsLabel.verticalCenter
    margin-left: 8
    width: 140
    height: 22

  Button
    id: openWorkCopyButton
    !text: tr('Open working copy')
    !tooltip: tr('Create or resume a work copy; installed assets stay unchanged.')
    anchors.left: versionComboBox.right
    anchors.verticalCenter: versionComboBox.verticalCenter
    margin-left: 8
    width: 142
    @onClick: modules.game_sprite_editor.openWorkCopy()

  Label
    id: statusLabel
    !text: tr('Choose an installed 15.x version, then open its safe working copy.')
    anchors.left: openWorkCopyButton.right
    anchors.right: parent.right
    anchors.verticalCenter: openWorkCopyButton.verticalCenter
    margin-left: 12
    text-wrap: true

  Panel
    id: pageNavigation
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: assetsLabel.bottom
    margin-top: 8
    height: 28

    AppearanceNavigationButton
      id: editorPageButton
      !text: tr('Browse')
      anchors.left: parent.left
      anchors.top: parent.top
      width: 150
      @onClick: modules.game_sprite_editor.showEditorPage()

    AppearanceNavigationButton
      id: importPageButton
      !text: tr('Import / create')
      anchors.left: editorPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 150
      @onClick: modules.game_sprite_editor.showImportPage()

    AppearanceNavigationButton
      id: exportPageButton
      !text: tr('Export package')
      anchors.left: importPageButton.right
      anchors.top: parent.top
      margin-left: 4
      width: 140
      @onClick: modules.game_sprite_editor.showExportPage()

  Panel
    id: appearancesPanel
    anchors.left: parent.left
    anchors.top: pageNavigation.bottom
    anchors.bottom: parent.bottom
    margin-top: 8
    margin-bottom: 33
    width: 190

    Label
      !text: tr('Appearance category')
      anchors.left: parent.left
      anchors.top: parent.top

    ComboBox
      id: appearanceCategory
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      margin-top: 4
      height: 22

    TextEdit
      id: appearanceSearch
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceCategory.bottom
      margin-top: 7
      height: 23
      !placeholder: tr('Search by name or ID')
      @onEnter: modules.game_sprite_editor.applyAppearanceSearch()

    Label
      id: appearanceResultsLabel
      !text: tr('Open a work copy to browse.')
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceSearch.bottom
      margin-top: 6
      text-wrap: false

    UIScrollArea
      id: appearanceList
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: appearanceResultsLabel.bottom
      anchors.bottom: parent.bottom
      margin-top: 5
      margin-right: 12
      vertical-scrollbar: appearanceListScroll
      auto-focus: none

      Panel
        id: appearanceListContent
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 1

    VerticalScrollBar
      id: appearanceListScroll
      anchors.top: appearanceList.top
      anchors.bottom: appearanceList.bottom
      anchors.right: parent.right
      step: 52
      pixels-scroll: true

  Panel
    id: editorCanvasFrame
    anchors.top: appearancesPanel.top
    anchors.left: appearancesPanel.right
    anchors.right: rightPanel.left
    anchors.bottom: appearancesPanel.bottom
    margin-left: 12
    margin-right: 12
    background-color: #242424

    UISpriteEditorCanvas
      id: canvas
      anchors.fill: parent
      margin: 4
      margin-bottom: 88
      focusable: true

  Label
    id: spriteInfoLabel
    !text: tr('Select an appearance to preview its sprite.')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.top: editorCanvasFrame.top
    margin: 8
    text-wrap: true

  Label
    id: previewHintLabel
    !text: tr('1x | Wheel: zoom | Middle-drag: pan | Checkerboard: transparency')
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 88
    text-wrap: true

  Panel
    id: previewControls
    anchors.left: editorCanvasFrame.left
    anchors.right: editorCanvasFrame.right
    anchors.bottom: editorCanvasFrame.bottom
    margin-left: 8
    margin-right: 8
    margin-bottom: 8
    height: 74
    background-color: #363636
    border-width: 1
    border-color: #4a4a4a
    visible: false

    Panel
      id: previewDirectionPad
      anchors.left: parent.left
      anchors.top: parent.top
      size: 150 68
      visible: false

      Button
        id: previewNorthWest
        !text: tr('NW')
        anchors.left: parent.left
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(7)

      Button
        id: previewNorth
        !text: tr('North')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(0)

      Button
        id: previewNorthEast
        !text: tr('NE')
        anchors.right: parent.right
        anchors.top: parent.top
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(4)

      Button
        id: previewWest
        !text: tr('West')
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(3)

      Label
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.verticalCenter: parent.verticalCenter
        !text: tr('Dir')
        text-align: center
        width: 48
        height: 21

      Button
        id: previewEast
        !text: tr('East')
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(1)

      Button
        id: previewSouthWest
        !text: tr('SW')
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(6)

      Button
        id: previewSouth
        !text: tr('South')
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(2)

      Button
        id: previewSouthEast
        !text: tr('SE')
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        size: 48 21
        @onClick: modules.game_sprite_editor.selectPreviewDirection(5)

    Panel
      id: previewSettings
      anchors.left: previewDirectionPad.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-left: 8

    ComboBox
      id: previewFrameGroup
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 94
      height: 21

    AppearanceOptionCheckBox
      id: previewMoving
      !text: tr('Moving')
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 90
      visible: false

    AppearanceOptionCheckBox
      id: previewMounted
      !text: tr('Mounted')
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 96
      width: 90
      visible: false

    ComboBox
      id: previewPatternX
      anchors.left: previewSettings.left
      anchors.top: parent.top
      width: 94
      height: 21

    ComboBox
      id: previewPatternY
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 100
      width: 88
      height: 21

    ComboBox
      id: previewLayer
      anchors.left: previewSettings.left
      anchors.top: parent.top
      margin-left: 200
      width: 82
      height: 21

    ComboBox
      id: previewPatternZ
      anchors.left: previewSettings.left
      anchors.top: previewFrameGroup.bottom
      margin-top: 4
      width: 90
      height: 22

    Label
      id: previewPhaseLabel
      !text: tr('Frame')
      anchors.left: previewSettings.left
      anchors.top: previewPatternZ.bottom
      margin-top: 5
      width: 45
      height: 21

    SpinBox
      id: previewPhaseStepper
      anchors.left: previewPhaseLabel.right
      anchors.verticalCenter: previewPhaseLabel.verticalCenter
      width: 66
      height: 22
      minimum: 1
      maximum: 1
      text: 1

    Label
      id: previewPhaseCount
      anchors.left: previewPhaseStepper.right
      anchors.verticalCenter: previewPhaseStepper.verticalCenter
      margin-left: 4
      width: 46
      height: 21
      text-wrap: false

  Panel
    id: rightPanel
    anchors.top: appearancesPanel.top
    anchors.right: parent.right
    anchors.bottom: appearancesPanel.bottom
    width: 320

    Panel
      id: propertiesPanel
      anchors.fill: parent

      AppearanceSectionHeader
        id: appearanceInfoLabel
        !text: tr('Select an appearance from the list.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      AppearanceFieldLabel
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: appearanceInfoLabel.bottom
        margin-top: 7

      AppearanceTextEdit
        id: appearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      AppearanceFieldLabel
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: appearanceName.bottom
        margin-top: 5

      AppearanceTextEdit
        id: appearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3

      Panel
        id: spriteReplacementPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: appearanceDescription.bottom
        margin-top: 6
        height: 46
        visible: false

        AppearanceFieldLabel
          id: selectedSpriteLabel
          !text: tr('Select a linked sprite to replace its PNG.')
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top
          height: 30
          text-wrap: true

        Panel
          id: previewSpritePathRow
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: selectedSpriteLabel.bottom
          margin-top: 3
          height: 22
          layout: horizontalBox

          AppearanceTextEdit
            id: previewSpritePathEdit
            width: 190
            margin-right: 5
            !placeholder: tr('Prepared PNG path')

          AppearanceActionButton
            id: replaceAppearanceSpriteButton
            !text: tr('Replace PNG')
            width: 104
            height: 22
            @onClick: modules.game_sprite_editor.replaceSprite()

      Panel
        id: propertiesTabBar
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: spriteReplacementPanel.bottom
        margin-top: 7
        height: 24
        layout: horizontalBox
        visible: false

        AppearanceNavigationButton
          id: flagsTabButton
          !text: tr('Flags')
          width: 96
          height: 24
          margin-right: 4
          @onClick: modules.game_sprite_editor.showPropertiesTab('flags')

        AppearanceNavigationButton
          id: valuesTabButton
          !text: tr('Values')
          width: 96
          height: 24
          margin-right: 4
          @onClick: modules.game_sprite_editor.showPropertiesTab('values')

        AppearanceNavigationButton
          id: animationTabButton
          !text: tr('Animation')
          width: 96
          height: 24
          @onClick: modules.game_sprite_editor.showPropertiesTab('animation')

      Label
        id: noPropertyOptionsLabel
        !text: tr('No flags, values or animation data for this appearance.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        margin-top: 4
        height: 21
        visible: false

      UIScrollArea
        id: appearanceFlagsList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceFlagsScroll
        layout: verticalBox
        padding: 3
        auto-focus: none

      VerticalScrollBar
        id: appearanceFlagsScroll
        anchors.top: appearanceFlagsList.top
        anchors.bottom: appearanceFlagsList.bottom
        anchors.right: parent.right
        step: 21
        pixels-scroll: true

      UIScrollArea
        id: appearanceValuesList
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceValuesScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

      VerticalScrollBar
        id: appearanceValuesScroll
        anchors.top: appearanceValuesList.top
        anchors.bottom: appearanceValuesList.bottom
        anchors.right: parent.right
        step: 24
        pixels-scroll: true
        visible: false

      UIScrollArea
        id: appearanceAnimationPanel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: propertiesTabBar.bottom
        anchors.bottom: appearanceStatus.top
        margin-top: 4
        margin-right: 12
        margin-bottom: 5
        vertical-scrollbar: appearanceAnimationScroll
        layout: verticalBox
        padding: 3
        auto-focus: none
        visible: false

        Label
          id: animationGroupInfo
          !text: tr('Select a frame group to edit its animation.')
          height: 33
          text-wrap: true

        Panel
          id: animationDefaultPhaseRow
          height: 25

          AppearanceFieldLabel
            !text: tr('Default phase')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          AppearanceTextEdit
            id: animationDefaultPhase
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 20

        AppearanceOptionCheckBox
          id: animationRandomStart
          !text: tr('Random start phase')

        AppearanceOptionCheckBox
          id: animationSynchronized
          !text: tr('Synchronized')

        Panel
          id: animationLoopTypeRow
          height: 25

          AppearanceFieldLabel
            !text: tr('Loop type')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          ComboBox
            id: animationLoopType
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 22

        Panel
          id: animationLoopCountRow
          height: 25

          AppearanceFieldLabel
            !text: tr('Loop count')
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: 82

          AppearanceTextEdit
            id: animationLoopCount
            anchors.left: prev.right
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            height: 20

        Label
          !text: tr('Frame durations (milliseconds)')
          height: 20

        Panel
          id: animationFrameDurations
          layout: verticalBox
          height: 1

      VerticalScrollBar
        id: appearanceAnimationScroll
        anchors.top: appearanceAnimationPanel.top
        anchors.bottom: appearanceAnimationPanel.bottom
        anchors.right: parent.right
        step: 27
        pixels-scroll: true
        visible: false

      Label
        id: appearanceStatus
        !text: tr('Saved in the working copy.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: saveAppearanceButton.top
        margin-bottom: 5
        height: 28
        text-wrap: true

      AppearanceActionButton
        id: saveAppearanceButton
        !text: tr('Save changes')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 0
        visible: false
        enabled: false
        @onClick: modules.game_sprite_editor.saveAppearanceProperties()

    Panel
      id: importPanel
      anchors.fill: parent
      visible: false

      AppearanceSectionHeader
        !text: tr('Create an appearance from a prepared PNG')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      AppearanceFieldLabel
        !text: tr('Name')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 8

      AppearanceTextEdit
        id: newAppearanceName
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4

      AppearanceFieldLabel
        !text: tr('Description')
        anchors.left: parent.left
        anchors.top: newAppearanceName.bottom
        margin-top: 7

      AppearanceTextEdit
        id: newAppearanceDescription
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4

      AppearanceFieldLabel
        !text: tr('Prepared PNG path')
        anchors.left: parent.left
        anchors.top: newAppearanceDescription.bottom
        margin-top: 7

      AppearanceTextEdit
        id: newAppearancePngPathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        !placeholder: tr('Paste the absolute path to a prepared PNG')

      AppearanceActionButton
        id: createAppearanceButton
        !text: tr('Create appearance from PNG')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: newAppearancePngPathEdit.bottom
        margin-top: 7
        @onClick: modules.game_sprite_editor.createAppearance()

      Label
        !text: tr('New entries use one 32 x 32 sprite. Existing sprites must match their current dimensions.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: createAppearanceButton.bottom
        margin-top: 6
        height: 38
        text-wrap: true

    Panel
      id: exportPanel
      anchors.fill: parent
      visible: false

      AppearanceSectionHeader
        !text: tr('Export the edited client assets')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top

      Label
        !text: tr('Export creates data/things/<version> inside the destination root. It leaves installed assets untouched and never overwrites an existing package.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 8
        height: 42
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('Current work copy')
        anchors.left: parent.left
        anchors.top: prev.bottom
        margin-top: 12

      AppearanceFieldLabel
        id: activeWorkCopyLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 3
        height: 48
        text-wrap: true

      AppearanceFieldLabel
        !text: tr('New destination root')
        anchors.left: parent.left
        anchors.top: activeWorkCopyLabel.bottom
        margin-top: 8

      AppearanceTextEdit
        id: exportPathEdit
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: prev.bottom
        margin-top: 4
        !placeholder: tr('Choose or enter an absolute folder path')

      AppearanceActionButton
        id: exportButton
        !text: tr('Export to new folder')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportPathEdit.bottom
        margin-top: 7
        @onClick: modules.game_sprite_editor.exportWorkCopy()

      Label
        id: exportStatus
        !text: tr('Choose a new destination folder. Existing folders are not overwritten.')
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: exportButton.bottom
        margin-top: 8
        height: 46
        text-wrap: true

  AppearanceActionButton
    id: reloadButton
    !text: tr('Reload saved copy')
    anchors.left: editorCanvasFrame.left
    anchors.bottom: parent.bottom
    width: 130
    height: 25
    !tooltip: tr('Reload saved changes from the work copy, not installed assets.')
    @onClick: modules.game_sprite_editor.reloadPackage()

  Button
    id: closeButton
    !text: tr('Close')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 80
    height: 25
    @onClick: modules.game_sprite_editor.requestClose()

SpriteEditorWindow
