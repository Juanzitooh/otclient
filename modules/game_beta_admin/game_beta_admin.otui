BetaAdminActionRow < UIButton
  height: 42
  focusable: false
  text-align: left
  background-color: #292929

  $hover:
    background-color: #373737

  $on:
    background-color: #454545

  Label
    id: actionWords
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4 6 0 7
    height: 16
    color: #f0f0f0
    text-auto-resize: false

  Label
    id: actionLevel
    anchors.top: actionWords.bottom
    anchors.left: actionWords.left
    anchors.right: parent.right
    height: 15
    color: #b5b5b5
    text-auto-resize: false

BetaAdminItemRow < UIButton
  height: 52
  focusable: false
  text-align: left
  background-color: #292929

  $hover:
    background-color: #373737

  $on:
    background-color: #454545

  UIItem
    id: itemSprite
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    phantom: true

  UICreature
    id: monsterSprite
    size: 40 40
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    visible: false
    phantom: true

  Label
    id: itemName
    anchors.top: parent.top
    anchors.left: itemSprite.right
    anchors.right: parent.right
    margin: 8 6 0 8
    height: 15
    text-auto-resize: false

  Label
    id: itemId
    anchors.top: itemName.bottom
    anchors.left: itemName.left
    anchors.right: parent.right
    height: 14
    color: #b5b5b5
    text-auto-resize: false

BetaAdminUserRow < UIButton
  height: 42
  focusable: false
  text-align: left
  background-color: #292929

  $hover:
    background-color: #373737

  $on:
    background-color: #454545

  Label
    id: userName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 4 6 0 7
    height: 16
    text-auto-resize: false

  Label
    id: userAccess
    anchors.top: userName.bottom
    anchors.left: userName.left
    anchors.right: parent.right
    height: 15
    color: #b5b5b5
    text-auto-resize: false

BetaAdminCapabilityRow < Panel
  height: 42

  Label
    id: capabilityName
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: changeCapabilityButton.left
    margin-left: 6
    height: 18
    text-auto-resize: false

  Label
    id: capabilityStatus
    anchors.top: capabilityName.bottom
    anchors.left: capabilityName.left
    anchors.right: capabilityName.right
    height: 15
    color: #b5b5b5
    text-auto-resize: false

  Button
    id: changeCapabilityButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: 4
    width: 96
    height: 30

BetaAdminTextFieldRow < Panel
  height: 58

  Label
    id: fieldLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 17
    text-auto-resize: false

  TextEdit
    id: fieldInput
    anchors.top: fieldLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    margin-top: 2

  Label
    id: fieldHelp
    anchors.top: fieldInput.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    color: #aaaaaa
    text-auto-resize: false

BetaAdminSelectFieldRow < Panel
  height: 58

  Label
    id: fieldLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 17
    text-auto-resize: false

  ComboBox
    id: fieldInput
    anchors.top: fieldLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 22
    margin-top: 2

  Label
    id: fieldHelp
    anchors.top: fieldInput.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 15
    color: #aaaaaa
    text-auto-resize: false

MainWindow
  id: gameBetaAdminWindow
  size: 940 620
  !text: tr('Administracao do beta')
  visible: false
  @onEscape: modules.game_beta_admin.GameBetaAdmin:hide()
  @onClose: modules.game_beta_admin.GameBetaAdmin:hide()

  Label
    id: accessLabel
    anchors.top: parent.top
    anchors.left: parent.left
    width: 500
    height: 22
    color: #d0d0d0
    !text: tr('Aguardando autorizacao do servidor...')

  Button
    id: refreshButton
    anchors.top: parent.top
    anchors.right: parent.right
    width: 92
    height: 22
    !text: tr('Atualizar')
    @onClick: modules.game_beta_admin.GameBetaAdmin:requestSnapshot()

  Panel
    id: tabBar
    anchors.top: accessLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    height: 26

    Button
      id: commandsTab
      anchors.top: parent.top
      anchors.left: parent.left
      width: 136
      height: 24
      !text: tr('TalkActions')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('commands')

    Button
      id: itemsTab
      anchors.top: parent.top
      anchors.left: commandsTab.right
      margin-left: 4
      width: 126
      height: 24
      visible: false
      !text: tr('Teste de itens')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('items')

    Button
      id: monstersTab
      anchors.top: parent.top
      anchors.left: itemsTab.right
      margin-left: 4
      width: 136
      height: 24
      visible: false
      !text: tr('Teste de monstros')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('monsters')

    Button
      id: usersTab
      anchors.top: parent.top
      anchors.left: monstersTab.right
      margin-left: 4
      width: 102
      height: 24
      visible: false
      !text: tr('Usuarios')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('users')

    Button
      id: feedbackTab
      anchors.top: parent.top
      anchors.left: usersTab.right
      margin-left: 4
      width: 90
      height: 24
      visible: false
      !text: tr('Feedback')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('feedback')

    Button
      id: operationsTab
      anchors.top: parent.top
      anchors.left: feedbackTab.right
      margin-left: 4
      width: 142
      height: 24
      visible: false
      !text: tr('Operacoes especiais')
      @onClick: modules.game_beta_admin.GameBetaAdmin:showPage('operations')

  Panel
    id: commandsPage
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5

    Label
      id: searchLabel
      anchors.top: parent.top
      anchors.left: parent.left
      width: 76
      height: 20
      !text: tr('Buscar')

    TextEdit
      id: actionSearch
      anchors.top: parent.top
      anchors.left: searchLabel.right
      anchors.right: parent.right
      height: 20
      @onTextChange: modules.game_beta_admin.GameBetaAdmin:onActionSearch(self:getText())

    Label
      id: levelLabel
      anchors.top: actionSearch.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 76
      height: 20
      !text: tr('Nivel')

    ComboBox
      id: levelFilter
      anchors.top: levelLabel.top
      anchors.left: levelLabel.right
      width: 180
      height: 20
      @onOptionChange: modules.game_beta_admin.GameBetaAdmin:onLevelFilterChange()

    Label
      id: actionCount
      anchors.top: levelLabel.top
      anchors.right: parent.right
      width: 110
      height: 20
      text-align: right
      color: #b5b5b5

    VerticalScrollBar
      id: actionsScrollBar
      anchors.top: levelLabel.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 5
      width: 15
      step: 42
      pixels-scroll: true

    ScrollablePanel
      id: actionsList
      anchors.top: actionsScrollBar.top
      anchors.left: actionsScrollBar.right
      anchors.bottom: parent.bottom
      width: 292
      margin-right: 6
      vertical-scrollbar: actionsScrollBar
      background-color: #222222
      border-width: 1
      border-color: #606060
      layout:
        type: verticalBox
        spacing: 2

    Panel
      id: actionDetails
      anchors.top: levelLabel.bottom
      anchors.left: actionsList.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 5
      background-color: #222222
      border-width: 1
      border-color: #606060

      Label
        id: selectedWords
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 7 8 0 8
        height: 22
        font: verdana-11px-monochrome
        text-auto-resize: false

      Label
        id: selectedLevel
        anchors.top: selectedWords.bottom
        anchors.left: selectedWords.left
        anchors.right: selectedWords.right
        height: 18
        color: #b5b5b5
        text-auto-resize: false

      Label
        id: selectedDescription
        anchors.top: selectedLevel.bottom
        anchors.left: selectedWords.left
        anchors.right: selectedWords.right
        height: 46
        text-wrap: true
        color: #d0d0d0
        text-auto-resize: false

      Label
        id: schemaMessage
        anchors.top: selectedDescription.bottom
        anchors.left: selectedWords.left
        anchors.right: selectedWords.right
        height: 48
        text-wrap: true
        color: #ffcc80
        text-auto-resize: false

      VerticalScrollBar
        id: fieldsScrollBar
        anchors.top: schemaMessage.bottom
        anchors.right: parent.right
        anchors.bottom: previewLabel.top
        margin: 4 6 4 0
        width: 14
        step: 58
        pixels-scroll: true

      ScrollablePanel
        id: fieldsList
        anchors.top: fieldsScrollBar.top
        anchors.left: selectedWords.left
        anchors.right: fieldsScrollBar.left
        anchors.bottom: fieldsScrollBar.bottom
        margin-right: 5
        vertical-scrollbar: fieldsScrollBar
        layout:
          type: verticalBox
          spacing: 2

      Label
        id: previewLabel
        anchors.left: selectedWords.left
        anchors.right: selectedWords.right
        anchors.bottom: executeButton.top
        margin-bottom: 5
        height: 40
        text-wrap: true
        color: #9ccc65
        text-auto-resize: false

      Button
        id: executeButton
        anchors.left: selectedWords.left
        anchors.right: selectedWords.right
        anchors.bottom: parent.bottom
        margin-bottom: 7
        height: 24
        enabled: false
        !text: tr('Executar TalkAction')
        @onClick: modules.game_beta_admin.GameBetaAdmin:executeTalkAction()

  Panel
    id: itemsPage
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5
    visible: false

    Label
      id: itemSearchLabel
      anchors.top: parent.top
      anchors.left: parent.left
      width: 82
      height: 20
      !text: tr('Item / ID')

    TextEdit
      id: itemSearch
      anchors.top: parent.top
      anchors.left: itemSearchLabel.right
      anchors.right: parent.right
      height: 20
      @onTextChange: modules.game_beta_admin.GameBetaAdmin:onItemSearchChange(self:getText())

    VerticalScrollBar
      id: itemResultsScrollBar
      anchors.top: itemSearch.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 8
      width: 15
      step: 54
      pixels-scroll: true

    ScrollablePanel
      id: itemResults
      anchors.top: itemResultsScrollBar.top
      anchors.left: itemResultsScrollBar.right
      anchors.bottom: parent.bottom
      width: 350
      margin-right: 8
      vertical-scrollbar: itemResultsScrollBar
      background-color: #222222
      border-width: 1
      border-color: #606060
      layout:
        type: verticalBox
        spacing: 2

    Panel
      id: itemGrantForm
      anchors.top: itemSearch.bottom
      anchors.left: itemResults.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      background-color: #222222
      border-width: 1
      border-color: #606060

      Label
        id: selectedItemLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: itemPreviewSprite.left
        margin: 8 8 0 8
        height: 24
        !text: tr('Selecione um item da busca.')

      UIItem
        id: itemPreviewSprite
        anchors.top: parent.top
        anchors.right: parent.right
        margin: 8
        size: 56 56
        visible: false
        phantom: true

      Label
        id: recipientLabel
        anchors.top: selectedItemLabel.bottom
        anchors.left: selectedItemLabel.left
        anchors.right: selectedItemLabel.right
        margin-top: 12
        height: 18
        !text: tr('Destinatario online')

      TextEdit
        id: itemRecipient
        anchors.top: recipientLabel.bottom
        anchors.left: recipientLabel.left
        anchors.right: recipientLabel.right
        height: 22
        @onTextChange: modules.game_beta_admin.GameBetaAdmin:onItemRecipientChange(self:getText())

      Label
        id: itemCountLabel
        anchors.top: itemRecipient.bottom
        anchors.left: recipientLabel.left
        margin-top: 10
        width: 140
        height: 18
        !text: tr('Quantidade (1-100)')

      TextEdit
        id: itemCount
        anchors.top: itemCountLabel.bottom
        anchors.left: itemCountLabel.left
        width: 140
        height: 22
        text: 1
        @onTextChange: modules.game_beta_admin.GameBetaAdmin:updateItemPreview()

      Label
        id: itemPreview
        anchors.top: itemCount.bottom
        anchors.left: recipientLabel.left
        anchors.right: recipientLabel.right
        margin-top: 10
        height: 44
        text-wrap: true
        color: #9ccc65

      Button
        id: giveItemButton
        anchors.left: recipientLabel.left
        anchors.right: recipientLabel.right
        anchors.bottom: parent.bottom
        margin-bottom: 8
        height: 24
        enabled: false
        !text: tr('Entregar item')
        @onClick: modules.game_beta_admin.GameBetaAdmin:confirmGiveItem()

      VerticalScrollBar
        id: itemRecipientResultsScrollBar
        anchors.top: itemRecipient.bottom
        anchors.right: parent.right
        margin-top: 4
        margin-right: 8
        width: 14
        height: 84
        step: 42
        pixels-scroll: true
        visible: false

      ScrollablePanel
        id: itemRecipientResults
        anchors.top: itemRecipient.bottom
        anchors.left: itemRecipient.left
        anchors.right: itemRecipientResultsScrollBar.left
        height: 84
        margin-top: 4
        vertical-scrollbar: itemRecipientResultsScrollBar
        background-color: #222222
        border-width: 1
        border-color: #606060
        visible: false
        layout:
          type: verticalBox
          spacing: 2

  Panel
    id: monstersPage
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5
    visible: false

    Label
      id: monsterSearchLabel
      anchors.top: parent.top
      anchors.left: parent.left
      width: 132
      height: 20
      !text: tr('Nome / LookType ID')

    TextEdit
      id: monsterSearch
      anchors.top: parent.top
      anchors.left: monsterSearchLabel.right
      anchors.right: parent.right
      height: 20
      @onTextChange: modules.game_beta_admin.GameBetaAdmin:onMonsterSearchChange(self:getText())

    VerticalScrollBar
      id: monsterResultsScrollBar
      anchors.top: monsterSearch.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 8
      width: 15
      step: 54
      pixels-scroll: true

    ScrollablePanel
      id: monsterResults
      anchors.top: monsterResultsScrollBar.top
      anchors.left: monsterResultsScrollBar.right
      anchors.bottom: parent.bottom
      width: 350
      margin-right: 8
      vertical-scrollbar: monsterResultsScrollBar
      background-color: #222222
      border-width: 1
      border-color: #606060
      layout:
        type: verticalBox
        spacing: 2

    Panel
      id: monsterSpawnForm
      anchors.top: monsterSearch.bottom
      anchors.left: monsterResults.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      background-color: #222222
      border-width: 1
      border-color: #606060

      Label
        id: selectedMonsterLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: monsterPreviewSprite.left
        margin: 8 8 0 8
        height: 24
        !text: tr('Selecione um monstro da busca.')

      UICreature
        id: monsterPreviewSprite
        anchors.top: parent.top
        anchors.right: parent.right
        margin: 4 8 0 0
        size: 64 64
        visible: false
        phantom: true
        animate: true

      Label
        id: monsterCountLabel
        anchors.top: selectedMonsterLabel.bottom
        anchors.left: selectedMonsterLabel.left
        margin-top: 12
        width: 140
        height: 18
        !text: tr('Quantidade (1-3)')

      TextEdit
        id: monsterCount
        anchors.top: monsterCountLabel.bottom
        anchors.left: monsterCountLabel.left
        width: 140
        height: 22
        text: 1
        @onTextChange: modules.game_beta_admin.GameBetaAdmin:updateMonsterPreview()

      Label
        id: monsterModeLabel
        anchors.top: monsterCountLabel.top
        anchors.left: monsterCountLabel.right
        margin-left: 16
        width: 140
        height: 18
        !text: tr('Tipo')

      ComboBox
        id: monsterMode
        anchors.top: monsterModeLabel.bottom
        anchors.left: monsterModeLabel.left
        width: 140
        height: 22
        @onOptionChange: modules.game_beta_admin.GameBetaAdmin:updateMonsterPreview()

      Label
        id: monsterPreview
        anchors.top: monsterCount.bottom
        anchors.left: selectedMonsterLabel.left
        anchors.right: parent.right
        margin-top: 10
        height: 44
        text-wrap: true
        color: #9ccc65

      Button
        id: spawnMonsterButton
        anchors.left: selectedMonsterLabel.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 0 8 8 8
        height: 24
        enabled: false
        !text: tr('Criar monstro')
        @onClick: modules.game_beta_admin.GameBetaAdmin:confirmSpawnMonster()

  Panel
    id: usersPage
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5
    visible: false

    Label
      id: userSearchLabel
      anchors.top: parent.top
      anchors.left: parent.left
      width: 82
      height: 20
      !text: tr('Jogador online')

    TextEdit
      id: userSearch
      anchors.top: parent.top
      anchors.left: userSearchLabel.right
      anchors.right: parent.right
      height: 20
      @onTextChange: modules.game_beta_admin.GameBetaAdmin:onUserSearchChange(self:getText())

    Label
      id: userScopeInfo
      anchors.top: userSearch.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 3
      height: 18
      color: #b5b5b5
      text-auto-resize: false

    VerticalScrollBar
      id: userResultsScrollBar
      anchors.top: userScopeInfo.bottom
      anchors.left: parent.left
      anchors.bottom: userLoadMoreButton.top
      margin-top: 8
      margin-bottom: 5
      width: 15
      step: 42
      pixels-scroll: true

    ScrollablePanel
      id: userResults
      anchors.top: userResultsScrollBar.top
      anchors.left: userResultsScrollBar.right
      anchors.bottom: userResultsScrollBar.bottom
      width: 310
      margin-right: 8
      vertical-scrollbar: userResultsScrollBar
      background-color: #222222
      border-width: 1
      border-color: #606060
      layout:
        type: verticalBox
        spacing: 2

    Button
      id: userLoadMoreButton
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 15
      width: 310
      height: 24
      enabled: false
      !text: tr('Carregar mais')
      @onClick: modules.game_beta_admin.GameBetaAdmin:loadMoreUsers()

    Panel
      id: userDetails
      anchors.top: userScopeInfo.bottom
      anchors.left: userResults.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 8 0 0 0
      background-color: #222222
      border-width: 1
      border-color: #606060

      Label
        id: selectedUserName
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin: 8 8 0 8
        height: 22
        font: verdana-11px-monochrome
        !text: tr('Selecione um jogador online.')

      Label
        id: currentUserAccess
        anchors.top: selectedUserName.bottom
        anchors.left: selectedUserName.left
        anchors.right: selectedUserName.right
        height: 20
        color: #b5b5b5
        text-auto-resize: false

      Panel
        id: userQuickActions
        anchors.top: currentUserAccess.bottom
        anchors.left: currentUserAccess.left
        anchors.right: currentUserAccess.right
        margin-top: 4
        height: 28
        visible: false
        layout:
          type: horizontalBox
          spacing: 6

        Label
          id: userQuickActionsLabel
          width: 90
          height: 24
          !text: tr('Acoes rapidas')

        Button
          id: userQuickKickButton
          width: 82
          height: 24
          visible: false
          !text: tr('Expulsar')

        Button
          id: userQuickBanButton
          width: 72
          height: 24
          visible: false
          !text: tr('Banir')

        Button
          id: userQuickTempleButton
          width: 95
          height: 24
          visible: false
          !text: tr('Enviar ao templo')

      Label
        id: readOnlySearchInfo
        anchors.top: userQuickActions.bottom
        anchors.left: selectedUserName.left
        anchors.right: selectedUserName.right
        margin-top: 8
        height: 28
        visible: false
        color: #b5b5b5
        text-auto-resize: false

      Label
        id: accountTypeScope
        anchors.top: userQuickActions.bottom
        anchors.left: selectedUserName.left
        anchors.right: selectedUserName.right
        margin-top: 8
        height: 18
        !text: tr('AccountType: TalkActions de todos os personagens da conta')

      ComboBox
        id: accountTypeSelection
        anchors.top: accountTypeScope.bottom
        anchors.left: accountTypeScope.left
        width: 240
        height: 22

      Button
        id: applyAccountTypeButton
        anchors.top: accountTypeSelection.top
        anchors.left: accountTypeSelection.right
        anchors.right: accountTypeScope.right
        margin-left: 6
        height: 22
        enabled: false
        !text: tr('Alterar conta')
        @onClick: modules.game_beta_admin.GameBetaAdmin:confirmAccountTypeChange()

      Label
        id: groupScope
        anchors.top: accountTypeSelection.bottom
        anchors.left: accountTypeScope.left
        anchors.right: accountTypeScope.right
        margin-top: 8
        height: 18
        !text: tr('Group: flags de jogo somente deste personagem')

      ComboBox
        id: groupSelection
        anchors.top: groupScope.bottom
        anchors.left: groupScope.left
        width: 240
        height: 22

      Button
        id: applyGroupButton
        anchors.top: groupSelection.top
        anchors.left: groupSelection.right
        anchors.right: groupScope.right
        margin-left: 6
        height: 22
        enabled: false
        !text: tr('Alterar grupo')
        @onClick: modules.game_beta_admin.GameBetaAdmin:confirmGroupChange()

      Label
        id: capabilitiesTitle
        anchors.top: groupSelection.bottom
        anchors.left: groupScope.left
        anchors.right: groupScope.right
        margin-top: 10
        height: 18
        !text: tr('Permissoes beta extras da conta')

      Label
        id: capabilityStoreStatus
        anchors.top: capabilitiesTitle.bottom
        anchors.left: capabilitiesTitle.left
        anchors.right: capabilitiesTitle.right
        height: 18
        color: #b5b5b5
        text-auto-resize: false

      VerticalScrollBar
        id: userCapabilitiesScrollBar
        anchors.top: capabilityStoreStatus.bottom
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin: 4 8 8 0
        width: 14
        step: 42
        pixels-scroll: true

      ScrollablePanel
        id: userCapabilities
        anchors.top: userCapabilitiesScrollBar.top
        anchors.left: capabilitiesTitle.left
        anchors.right: userCapabilitiesScrollBar.left
        anchors.bottom: userCapabilitiesScrollBar.bottom
        margin-right: 5
        vertical-scrollbar: userCapabilitiesScrollBar
        layout:
          type: verticalBox
          spacing: 1

  Panel
    id: feedbackHost
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5
    visible: false

  Panel
    id: operationsHost
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 5
    margin-bottom: 5
    visible: false

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 20
    color: #b5b5b5
    text-auto-resize: false
    !text: tr('Desconectado.')
