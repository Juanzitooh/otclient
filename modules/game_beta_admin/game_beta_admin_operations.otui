BetaAdminElevationRow < Panel
  height: 60

  BetaAdminLabel
    id: elevationSummary
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 2 4 0 5
    height: 28
    color: #dedede
    text-auto-resize: false

  BetaAdminButton
    id: approveButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin: 2 0 3 5
    width: 68
    height: 21
    !text: tr('Aprovar')

  BetaAdminButton
    id: denyButton
    anchors.left: approveButton.right
    anchors.bottom: approveButton.bottom
    margin-left: 4
    width: 68
    height: 21
    !text: tr('Recusar')

  BetaAdminButton
    id: revokeButton
    anchors.left: denyButton.right
    anchors.bottom: approveButton.bottom
    margin-left: 4
    width: 74
    height: 21
    !text: tr('Revogar')

Panel
  id: gameBetaAdminOperationsPage
  anchors.top: parent.top
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.bottom: parent.bottom
  visible: false

  Panel
    id: compensationPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 3 4 4 4

    BetaAdminLabel
      id: compensationTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      color: #f0d080
      !text: tr('Compensacao limitada do CM')

    BetaAdminLabel
      id: compensationScope
      anchors.top: compensationTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 42
      color: #b5b5b5
      text-wrap: true

    BetaAdminLabel
      id: compensationTargetLabel
      anchors.top: compensationScope.bottom
      anchors.left: parent.left
      width: 92
      height: 21
      !text: tr('Personagem online')

    BetaAdminTextEdit
      id: compensationTarget
      anchors.top: compensationTargetLabel.top
      anchors.left: compensationTargetLabel.right
      anchors.right: parent.right
      height: 21
      @onTextChange: modules.game_beta_admin.BetaAdminOperations:updatePreview()

    BetaAdminLabel
      id: compensationAmountLabel
      anchors.top: compensationTarget.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 92
      height: 21
      !text: tr('Ouro no banco')

    BetaAdminTextEdit
      id: compensationAmount
      anchors.top: compensationAmountLabel.top
      anchors.left: compensationAmountLabel.right
      width: 130
      height: 21
      text: 1
      @onTextChange: modules.game_beta_admin.BetaAdminOperations:updatePreview()

    BetaAdminLabel
      id: compensationReasonLabel
      anchors.top: compensationAmount.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 92
      height: 21
      !text: tr('Motivo')

    BetaAdminTextEdit
      id: compensationReason
      anchors.top: compensationReasonLabel.top
      anchors.left: compensationReasonLabel.right
      anchors.right: parent.right
      height: 21
      @onTextChange: modules.game_beta_admin.BetaAdminOperations:updatePreview()

    BetaAdminLabel
      id: compensationTicketLabel
      anchors.top: compensationReason.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 92
      height: 21
      !text: tr('Bug / ticket')

    BetaAdminTextEdit
      id: compensationTicket
      anchors.top: compensationTicketLabel.top
      anchors.left: compensationTicketLabel.right
      anchors.right: parent.right
      height: 21
      @onTextChange: modules.game_beta_admin.BetaAdminOperations:updatePreview()

    BetaAdminLabel
      id: compensationPreview
      anchors.top: compensationTicket.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 7
      height: 58
      color: #d0d0d0
      text-wrap: true

    BetaAdminPrimaryButton
      id: compensationConfirmButton
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      width: 150
      height: 24
      enabled: false
      !text: tr('Revisar compensacao')
      @onClick: modules.game_beta_admin.BetaAdminOperations:submitCompensation()

    BetaAdminLabel
      id: compensationStatus
      anchors.left: compensationConfirmButton.right
      anchors.right: parent.right
      anchors.verticalCenter: compensationConfirmButton.verticalCenter
      margin-left: 8
      height: 32
      color: #b5b5b5
      text-wrap: true

  Panel
    id: elevationPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin: 3 4 4 4

    BetaAdminLabel
      id: elevationTitle
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 22
      color: #f0d080
      !text: tr('Elevacao tecnica temporaria')

    BetaAdminLabel
      id: elevationScope
      anchors.top: elevationTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 42
      color: #b5b5b5
      text-wrap: true

    BetaAdminLabel
      id: elevationCapabilityLabel
      anchors.top: elevationScope.bottom
      anchors.left: parent.left
      width: 88
      height: 21
      !text: tr('Acesso de teste')

    BetaAdminComboBox
      id: elevationCapability
      anchors.top: elevationCapabilityLabel.top
      anchors.left: elevationCapabilityLabel.right
      anchors.right: parent.right
      height: 21

    BetaAdminLabel
      id: elevationDurationLabel
      anchors.top: elevationCapabilityLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 88
      height: 21
      !text: tr('Duracao maxima')

    BetaAdminComboBox
      id: elevationDuration
      anchors.top: elevationDurationLabel.top
      anchors.left: elevationDurationLabel.right
      width: 82
      height: 21

    BetaAdminLabel
      id: elevationReasonLabel
      anchors.top: elevationDuration.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 88
      height: 21
      !text: tr('Motivo')

    BetaAdminTextEdit
      id: elevationReason
      anchors.top: elevationReasonLabel.top
      anchors.left: elevationReasonLabel.right
      anchors.right: parent.right
      height: 21

    BetaAdminLabel
      id: elevationTicketLabel
      anchors.top: elevationReason.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 88
      height: 21
      !text: tr('Bug / ticket')

    BetaAdminTextEdit
      id: elevationTicket
      anchors.top: elevationTicketLabel.top
      anchors.left: elevationTicketLabel.right
      width: 122
      height: 21

    BetaAdminPrimaryButton
      id: elevationRequestButton
      anchors.top: elevationTicket.top
      anchors.left: elevationTicket.right
      margin-left: 5
      width: 102
      height: 21
      enabled: false
      !text: tr('Solicitar acesso')
      @onClick: modules.game_beta_admin.BetaAdminOperations:requestElevation()

    BetaAdminButton
      id: elevationRefreshButton
      anchors.top: elevationRequestButton.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 104
      height: 21
      !text: tr('Atualizar lista')
      @onClick: modules.game_beta_admin.BetaAdminOperations:refreshElevations()

    BetaAdminLabel
      id: elevationListStatus
      anchors.left: elevationRefreshButton.right
      anchors.right: parent.right
      anchors.verticalCenter: elevationRefreshButton.verticalCenter
      margin-left: 8
      height: 24
      color: #b5b5b5
      text-wrap: true

    VerticalScrollBar
      id: elevationScrollBar
      anchors.top: elevationRefreshButton.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-bottom: 3
      width: 12
      step: 60
      pixels-scroll: true

    ScrollablePanel
      id: elevationRequests
      anchors.top: elevationScrollBar.top
      anchors.left: elevationScrollBar.right
      anchors.right: parent.right
      anchors.bottom: elevationScrollBar.bottom
      margin-left: 4
      vertical-scrollbar: elevationScrollBar
      layout:
        type: verticalBox
        spacing: 2
